{
  "name": "hud-clear",
  "viewport": "phone",
  "steps": [
    {
      "do": "expect",
      "text": "Versus CPU",
      "timeoutMs": 90000,
      "look": "Is every title button clear of the lower corners?"
    },
    { "do": "tap", "text": "Versus CPU" },
    { "do": "expect", "pixels": "changed", "timeoutMs": 20000 },
    { "do": "wait", "ms": 3500 },
    { "do": "tap", "selector": "[aria-label=\"Move left\"]" },
    {
      "do": "expect",
      "pixels": "nonblank",
      "look": "Do the on-screen buttons stay off your board, the score and the next piece?"
    },
