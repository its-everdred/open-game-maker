#!/bin/sh
set -eu

root=$(git rev-parse --show-toplevel)
cd "$root"

staged=$(mktemp)
trap 'rm -f "$staged"' EXIT HUP INT TERM
git diff --cached --name-only --diff-filter=ACMR -z > "$staged"
[ -s "$staged" ] || exit 0

xargs -0 -r pnpm exec prettier --write --ignore-unknown -- < "$staged"
xargs -0 -r git add -- < "$staged"
