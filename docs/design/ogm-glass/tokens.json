{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "OGM Glass tokens. Source: Claude Design canvas https://claude.ai/artifact/2R9v9J41qPrtnay5DbbUjM (System page). Values extend apps/web/src/tokens.css; names map to CSS custom properties in glass.css.",
  "color": {
    "ground": {
      "night": {
        "$value": "#0f0e16",
        "$description": "--night, page"
      },
      "night-2": {
        "$value": "#1a1824",
        "$description": "--night-2, deep wells"
      },
      "night-3": {
        "$value": "#282532",
        "$description": "--night-3"
      }
    },
    "ink": {
      "ink": {
        "$value": "#f2ead6"
      },
      "ink-2": {
        "$value": "rgba(242,234,214,.82)"
      },
      "muted": {
        "$value": "#c4beb0",
        "$description": "secondary text; passes 4.5:1 on night"
      },
      "rule": {
        "$value": "rgba(242,234,214,.14)"
      },
      "dark": {
        "$value": "#1d1b16",
        "$description": "text on solid colour"
      }
    },
    "role": {
      "go": {
        "$value": "#94d742",
        "$description": "Start, Play, Send, done"
      },
      "create": {
        "$value": "#ffbf32",
        "$description": "New game, Edit"
      },
      "needs-you": {
        "$value": "#ff9133",
        "$description": "reviews, questions, badge dot"
      },
      "working": {
        "$value": "#74c8ed",
        "$description": "progress, links"
      },
      "agents": {
        "$value": "#d795e4",
        "$description": "activity banner, live voice"
      },
      "danger": {
        "$value": "#f76d67",
        "$description": "stop, bug, unpublish"
      },
      "danger-ink": {
        "$value": "#ff9b8f"
      },
      "focus": {
        "$value": "#6fd6b4",
        "$description": "3px focus ring, 2px offset"
      }
    },
    "resource": {
      "minerals": {
        "$value": [
          "#05cde6",
          "#168efd",
          "#4146ff"
        ],
        "$description": "gradient of aiur's mineral SVG (aiur src/priv/static/claude-token.svg, used verbatim)"
      },
      "gas": {
        "$value": [
          "#b7f171",
          "#46c46a",
          "#1f8a52"
        ],
        "$description": "stand-in green rock; replace with aiur's gas SVG once located (not in aiur main 2026-11-26)"
      }
    },
    "glow": {
      "1": {
        "$value": "rgb(214 93 14 / .34)"
      },
      "2": {
        "$value": "rgb(177 98 134 / .32)"
      },
      "3": {
        "$value": "rgb(69 133 136 / .36)"
      },
      "4": {
        "$value": "rgb(215 153 33 / .22)"
      },
      "periods": {
        "$value": [
          "41s",
          "53s",
          "47s",
          "61s"
        ]
      }
    }
  },
  "glass": {
    "fill": {
      "$value": "rgba(24,22,32,.55)"
    },
    "fill-strong": {
      "$value": "rgba(30,27,40,.88)",
      "$description": "menus and sheets over a live game"
    },
    "tint": {
      "$value": "color-mix(in srgb, <role> 14%, fill)"
    },
    "blur": {
      "$value": "blur(22px) saturate(1.4)"
    },
    "edge": {
      "$value": "linear-gradient(to bottom, rgba(242,234,214,.05), rgba(242,234,214,.16) 45%, rgba(242,234,214,.42))",
      "$description": "1px masked ::before ring, never a border-box background (it bleeds through translucent fills)"
    },
    "gloss": {
      "$value": "linear-gradient(180deg, rgba(255,255,255,.24), rgba(255,255,255,.04) 50%, rgba(255,255,255,0) 51%)",
      "$description": "top-half highlight on orbs, pills, switches"
    },
    "scrim": {
      "$value": "rgba(15,14,22,.5) + blur(5px)"
    }
  },
  "radius": {
    "xs": "8px",
    "sm": "12px",
    "md": "16px",
    "lg": "20px",
    "xl": "28px",
    "pill": "999px"
  },
  "size": {
    "hit-min": "44px",
    "orb": {
      "sm": "40px",
      "md": "48px",
      "lg": "60px",
      "fab": "64px"
    },
    "pill": {
      "sm": "44px",
      "md": "52px",
      "lg": "68px"
    },
    "top-bar": "76px phone, 90px desktop",
    "phone-gutter": "14-16px"
  },
  "space": [
    "4px",
    "8px",
    "12px",
    "16px",
    "20px",
    "24px",
    "32px"
  ],
  "type": {
    "display": {
      "family": "Fredoka",
      "weights": [
        500,
        600,
        700
      ],
      "fallback": [
        "Nunito",
        "system-ui",
        "sans-serif"
      ]
    },
    "body": {
      "family": "Nunito",
      "weights": [
        600,
        700,
        800
      ],
      "fallback": [
        "system-ui",
        "sans-serif"
      ]
    },
    "scale": {
      "hero": "48px/700 display (desktop spotlight)",
      "h1": "30px/700 display",
      "h2": "24px/600 display",
      "h3": "18px/600 display",
      "num": "20px/700 display tabular",
      "body": "15px/600 body",
      "sub": "14px/600 body muted",
      "cap": "11px/800 body, uppercase, .09em"
    }
  },
  "motion": {
    "ease": {
      "$value": "cubic-bezier(.22,1,.36,1)",
      "duration": "300ms"
    },
    "spring": {
      "$value": "cubic-bezier(.2,.9,.3,1.2)",
      "duration": "600ms",
      "$description": "sheets, cards arriving"
    },
    "reduced": "no drift, no spring, no breathe"
  },
  "component": {
    "orb-fill": "rgba(55,51,64,.5)",
    "orb-edge": "rgba(255,255,255,.38)",
    "orb-blur": "blur(14px) saturate(1.35)",
    "orb-shadow": "inset 0 1px 0 rgba(255,255,255,.5), 0 8px 22px rgba(0,0,0,.3)",
    "button-fill": "rgba(57,54,67,.6)",
    "button-edge": "rgba(255,255,255,.3)",
    "button-shadow": "inset 0 1px 0 rgba(255,255,255,.4), 0 6px 18px rgba(0,0,0,.25)",
    "action-edge": "rgba(255,255,255,.55)",
    "action-shadow": "inset 0 1px 0 rgba(255,255,255,.6), 0 12px 30px -10px var(--ogm-action-color)",
    "pane-shadow": "0 18px 44px rgba(0,0,0,.32)",
    "row-fill": "rgba(57,54,67,.5)",
    "row-edge": "rgba(242,234,214,.08)",
    "field-fill": "rgba(15,14,22,.45)",
    "placeholder": "rgba(242,234,214,.45)",
    "switch-fill": "rgba(57,54,67,.8)",
    "switch-knob": "#d9d2c2",
    "white": "#ffffff",
    "switch-shadow": "0 2px 6px rgba(0,0,0,.35)",
    "status-wait": "#5a5566",
    "progress-track": "rgba(15,14,22,.6)",
    "scrim-fill": "rgba(15,14,22,.5)",
    "scrim-blur": "blur(5px)",
    "disabled-opacity": ".45",
    "disabled-saturation": ".4",
    "button-font": "600 18px/1 var(--ogm-font-display)",
    "status-font": "800 12px/1 var(--ogm-font-body)",
    "field-font": "600 16px var(--ogm-font-body)",
    "label-font": "800 12px/1 var(--ogm-font-body)",
    "row-radius": "18px",
    "status-radius": "12px",
    "bar-radius": "4px",
    "switch-radius": "16px",
    "label-tracking": ".06em",
    "focus-width": "3px",
    "focus-offset": "2px",
    "mask-gradient": "linear-gradient(#ffffff 0 0)",
    "tint-mix": "14%",
    "live-fill": "color-mix(in srgb, #d795e4 70%, #2a2140)",
    "button-font-sm": "600 16px/1 var(--ogm-font-display)",
    "button-font-lg": "600 24px/1 var(--ogm-font-display)",
    "tag-fill": "rgba(57,54,67,.45)",
    "tag-font": "700 13px/1 var(--ogm-font-body)",
    "tag-radius": "14px",
    "resource-fill": "rgba(40,36,52,.55)",
    "resource-edge": "rgba(255,255,255,.26)",
    "resource-shadow": "inset 0 1px 0 rgba(255,255,255,.35)",
    "resource-font": "700 15px/1 var(--ogm-font-display)",
    "resource-radius": "20px",
    "resource-blur": "blur(14px)",
    "banner-fill": "rgba(24,22,32,.62)",
    "banner-mix": "16%",
    "banner-shadow": "0 12px 30px -12px var(--ogm-role-agents)",
    "banner-font": "700 14px/1.2 var(--ogm-font-body)",
    "banner-radius": "24px",
    "message-agent-fill": "rgba(57,54,67,.85)",
    "message-font": "600 15px/1.38 var(--ogm-font-body)",
    "message-system-font": "700 13px/1.3 var(--ogm-font-body)",
    "message-radius": "18px",
    "message-tail-radius": "6px",
    "row-title-font": "600 17px/1.2 var(--ogm-font-display)",
    "row-detail-font": "700 13px/1.3 var(--ogm-font-body)",
    "composer-placeholder": "rgba(242,234,214,.5)",
    "composer-font": "600 16px var(--ogm-font-body)",
    "banner-edge": "linear-gradient(to bottom, color-mix(in srgb, var(--ogm-role-agents) 20%, transparent), var(--ogm-role-agents))",
    "banner-pulse-shadow": "0 0 0 4px color-mix(in srgb, var(--ogm-role-agents) 30%, transparent)",
    "tint-edge": "linear-gradient(to bottom, color-mix(in srgb, var(--ogm-action-color) 18%, transparent), var(--ogm-action-color))",
    "glassy-fill": "color-mix(in srgb, var(--ogm-action-color) 30%, rgba(24,22,32,.35))",
    "glassy-edge": "linear-gradient(to bottom, color-mix(in srgb, var(--ogm-action-color) 20%, transparent), var(--ogm-action-color))",
    "glassy-shadow": "0 10px 30px -10px var(--ogm-action-color)",
    "overlay-z": "1000",
    "sheet-title-font": "600 24px/1.15 var(--ogm-font-display)",
    "sheet-enter-distance": "12px",
    "motion-hidden": "0",
    "motion-visible": "1",
    "segment-fill": "rgba(15,14,22,.5)",
    "segment-font": "700 15px var(--ogm-font-body)",
    "slider-height": "26px",
    "slider-track-height": "8px",
    "slider-knob-offset": "-9px",
    "slider-shadow": "0 2px 8px rgba(0,0,0,.4)",
    "slider-track": "linear-gradient(to right, var(--ogm-role-go) 0 var(--ogm-slider-fill), var(--ogm-component-progress-track) var(--ogm-slider-fill) 100%)",
    "menu-font": "600 16px/1 var(--ogm-font-display)",
    "meter-fill": "rgba(57,54,67,.42)",
    "meter-title-font": "600 16px/1 var(--ogm-font-display)",
    "meter-value-font": "700 17px/1 var(--ogm-font-display)",
    "meter-detail-font": "700 12px/1.2 var(--ogm-font-body)",
    "minerals-gradient": "linear-gradient(90deg, var(--ogm-resource-minerals-1), var(--ogm-resource-minerals-3))",
    "gas-gradient": "linear-gradient(90deg, var(--ogm-resource-gas-1), var(--ogm-resource-gas-3))",
    "option-fill": "rgba(255,255,255,.03)",
    "option-selected-base": "rgba(255,255,255,.02)",
    "option-edge": "linear-gradient(to bottom, color-mix(in srgb, var(--ogm-action-color) 40%, #fbf1c7), var(--ogm-action-color))",
    "option-shadow": "0 16px 40px -16px var(--ogm-action-color)",
    "option-font": "700 13px/1.1 var(--ogm-font-body)",
    "cover-fill": "#000000",
    "cover-shade": "linear-gradient(to top, rgba(11,10,7,.92), rgba(11,10,7,.35) 38%, transparent 62%)",
    "cover-name-font": "700 22px/1.05 var(--ogm-font-display)",
    "cover-name-shadow": "0 2px 8px rgba(0,0,0,.6)"
  }
}
