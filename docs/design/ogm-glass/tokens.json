{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "OGM Glass tokens. Source: Claude Design canvas https://claude.ai/artifact/2R9v9J41qPrtnay5DbbUjM (System page). Values extend apps/web/src/tokens.css; names map to CSS custom properties in glass.css.",
  "color": {
    "ground": {
      "night": { "$value": "#0f0e16", "$description": "--night, page" },
      "night-2": { "$value": "#1a1824", "$description": "--night-2, deep wells" },
      "night-3": { "$value": "#282532", "$description": "--night-3" }
    },
    "ink": {
      "ink": { "$value": "#f2ead6" },
      "ink-2": { "$value": "rgba(242,234,214,.82)" },
      "muted": { "$value": "#c4beb0", "$description": "secondary text; passes 4.5:1 on night" },
      "rule": { "$value": "rgba(242,234,214,.14)" },
      "dark": { "$value": "#1d1b16", "$description": "text on solid colour" }
    },
    "role": {
      "go": { "$value": "#94d742", "$description": "Start, Play, Send, done" },
      "create": { "$value": "#ffbf32", "$description": "New game, Edit" },
      "needs-you": { "$value": "#ff9133", "$description": "reviews, questions, badge dot" },
      "working": { "$value": "#74c8ed", "$description": "progress, links" },
      "agents": { "$value": "#d795e4", "$description": "activity banner, live voice" },
      "danger": { "$value": "#f76d67", "$description": "stop, bug, unpublish" },
      "danger-ink": { "$value": "#ff9b8f" },
      "focus": { "$value": "#6fd6b4", "$description": "3px focus ring, 2px offset" }
    },
    "resource": {
      "minerals": { "$value": ["#05cde6", "#168efd", "#4146ff"], "$description": "gradient of aiur's mineral SVG (aiur src/priv/static/claude-token.svg, used verbatim)" },
      "gas": { "$value": ["#b7f171", "#46c46a", "#1f8a52"], "$description": "stand-in green rock; replace with aiur's gas SVG once located (not in aiur main 2026-11-26)" }
    },
    "glow": {
      "1": { "$value": "rgb(214 93 14 / .34)" },
      "2": { "$value": "rgb(177 98 134 / .32)" },
      "3": { "$value": "rgb(69 133 136 / .36)" },
      "4": { "$value": "rgb(215 153 33 / .22)" },
      "periods": { "$value": ["41s", "53s", "47s", "61s"] }
    }
  },
  "glass": {
    "fill": { "$value": "rgba(24,22,32,.55)" },
    "fill-strong": { "$value": "rgba(30,27,40,.88)", "$description": "menus and sheets over a live game" },
    "tint": { "$value": "color-mix(in srgb, <role> 14%, fill)" },
    "blur": { "$value": "blur(22px) saturate(1.4)" },
    "edge": { "$value": "linear-gradient(to bottom, rgba(242,234,214,.05), rgba(242,234,214,.16) 45%, rgba(242,234,214,.42))", "$description": "1px masked ::before ring, never a border-box background (it bleeds through translucent fills)" },
    "gloss": { "$value": "linear-gradient(180deg, rgba(255,255,255,.24), rgba(255,255,255,.04) 50%, rgba(255,255,255,0) 51%)", "$description": "top-half highlight on orbs, pills, switches" },
    "scrim": { "$value": "rgba(15,14,22,.5) + blur(5px)" }
  },
  "radius": { "xs": "8px", "sm": "12px", "md": "16px", "lg": "20px", "xl": "28px", "pill": "999px" },
  "size": {
    "hit-min": "44px",
    "orb": { "sm": "40px", "md": "48px", "lg": "60px", "fab": "64px" },
    "pill": { "sm": "44px", "md": "52px", "lg": "68px" },
    "top-bar": "76px phone, 90px desktop",
    "phone-gutter": "14-16px"
  },
  "space": ["4px", "8px", "12px", "16px", "20px", "24px", "32px"],
  "type": {
    "display": { "family": "Fredoka", "weights": [500, 600, 700] },
    "body": { "family": "Nunito", "weights": [600, 700, 800] },
    "scale": {
      "hero": "48px/700 display (desktop spotlight)",
      "h1": "30px/700 display",
      "h2": "24px/600 display",
      "h3": "18px/600 display",
      "num": "20px/700 display tabular",
      "body": "15px/600 body",
      "sub": "14px/600 body muted",
      "cap": "11px/800 body, uppercase, .09em"
    }
  },
  "motion": {
    "ease": { "$value": "cubic-bezier(.22,1,.36,1)", "duration": "300ms" },
    "spring": { "$value": "cubic-bezier(.2,.9,.3,1.2)", "duration": "600ms", "$description": "sheets, cards arriving" },
    "reduced": "no drift, no spring, no breathe"
  }
}
