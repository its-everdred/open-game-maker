# Open Game Maker 2000 environment names. Real files live in ~/.config/ogm/env/<unit>.env (0600), one per unit.
# Values never go in this file or in git. Create a unit file with: pnpm --filter @ogm/config exec ogm-env-init <unit>
# [api] loopback port of the API
OGM_API_PORT=
# [api] raw analytics retention in days (default 90)
OGM_ANALYTICS_RETENTION_DAYS=
# [api] default per-member daily build allowance in integer micro-USD
OGM_DEFAULT_DAILY_ALLOWANCE_MICROUSD=
# [api] default IANA time zone for family budget resets
OGM_RESET_ZONE_DEFAULT=
# [api] assets-local/inbox (Drive intake queue, read-only for the admin API)
OGM_INTAKE_DIR=
# [api] largest bug-report diagnostic bundle in bytes (default 2097152)
OGM_REPORT_BUNDLE_MAX_BYTES=
# [api] largest blob a game daemon may put in bytes (default 67108864)
OGM_BLOB_PUT_MAX_BYTES=
# [api] parallel narration renders (default 2)
OGM_NARRATION_CONCURRENCY=
# [rooms] loopback port of the Colyseus relay
OGM_ROOMS_PORT=
# [games] loopback port of the games origin host
OGM_GAMES_PORT=
# [games] compiled game cache worker script
OGM_GAMES_SW=
# [commit] loopback port of the commit service
OGM_COMMIT_PORT=
# [voice-host] loopback port of the voice host
OGM_VOICE_PORT=
# [shared] https://<tailnet-host>:8443
OGM_PUBLIC_ORIGIN=
# [shared] https://<tailnet-host>:10000
OGM_GAMES_ORIGIN=
# [shared] https://makeopen.games (frame-ancestors, CORS)
OGM_APP_ORIGIN=
# [web] public app origin deploy.sh uses for the retired Netlify-host redirect
OGM_PUBLIC_APP_ORIGIN=
# [web] ship every host-library asset used by instance screens (default true)
OGM_INSTANCE_ALL_ASSETS=
# [web] games origin deploy.sh bakes into the app build (same as OGM_GAMES_ORIGIN)
VITE_GAMES_ORIGIN=
# [web] API origin deploy.sh writes into Netlify _redirects for /api and /auth (same as OGM_PUBLIC_ORIGIN)
VITE_API_ORIGIN=
# [web] public STUN/TURN URLs for the optional peer-to-peer transport (comma separated, no credentials)
VITE_ICE_URLS=
# [web] optional root-relative path or HTTPS URL for the instance logo (PNG, WebP, or SVG)
VITE_INSTANCE_LOGO_URL=
# [shared] ~/.local/share/ogm/data (SQLite, state)
OGM_DATA_DIR=
# [shared] ~/.local/share/ogm/blobs
OGM_BLOB_ROOT=
# [shared] ~/.local/share/ogm/games (release directories)
OGM_GAMES_ROOT=
# [api] HMAC key for signed blob URLs
OGM_BLOB_SIGNING_KEY=
# [api] ~/.config/ogm/env/ogm-api.vapid.json (generated Web Push keys)
OGM_VAPID_KEY_FILE=
# [api] contact email for Web Push (without mailto:)
OGM_VAPID_SUBJECT=
# [api] Better Auth secret
OGM_SESSION_SECRET=
# [shared] HS256 key for room/chat grants (api, rooms)
OGM_WS_TOKEN_SECRET=
# [shared] backend -> rooms internal bearer
OGM_ROOMS_INTERNAL_SECRET=
# [api] http://127.0.0.1:4302 (loopback rooms service)
OGM_ROOMS_INTERNAL_URL=
# [shared] HMAC key for voice tokens (api, voice-host)
OGM_VOICE_TOKEN_SECRET=
# [api] http://127.0.0.1:<OGM_VOICE_PORT> (loopback voice host; briefing push off when unset)
OGM_VOICE_HOST_INTERNAL_URL=
# [shared] backend -> voice host internal bearer (api, voice-host)
OGM_VOICE_INTERNAL_SECRET=
# [shared] backend -> commit service bearer
OGM_COMMIT_SERVICE_TOKEN=
# [api] http://127.0.0.1:4301 (loopback commit service)
OGM_COMMIT_INTERNAL_URL=
# [api] game repository template ref
OGM_GAME_TEMPLATE_REF=
# [shared] owner/repository of the instance repository that holds every game under games/<slug>
OGM_INSTANCE_REPO=
# [api] builder bot PAT written only to daemon env files
OGM_BUILDER_BOT_TOKEN=
# [shared] builder bot invited to game repositories
OGM_BUILDER_BOT_LOGIN=
# [api] intake bot PAT for game repository issues
OGM_INTAKE_GITHUB_TOKEN=
# [api] intake bot allowed to apply agent:todo
OGM_INTAKE_BOT_LOGIN=
# [api] admitted-job recovery sweep period (default 60)
OGM_INTAKE_SWEEP_SECONDS=
# [api] http://127.0.0.1:4001 (platform) or the daemon in question
AIUR_API_URL=
# [api] one write token per daemon; never in the sandbox
AIUR_API_TOKEN=
# [aiur] aiur run --container cookie (>= 16 chars)
AIUR_ERLANG_COOKIE=
# [aiur] machine-user bot PAT for game repos (aiur name)
GITHUB_TOKEN=
# [commit] OGM GitHub App id
GITHUB_APP_ID=
# [commit] installation id on Kevin's account
GITHUB_APP_INSTALLATION_ID=
# [commit] PEM path under ~/.config/ogm
GITHUB_APP_PRIVATE_KEY_PATH=
# [commit] App OAuth client id; set with the secret to accept GitHub connections
GITHUB_APP_CLIENT_ID=
# [commit] App OAuth client secret; proves which account controls an installation
GITHUB_APP_CLIENT_SECRET=
# [backup] ssh:<host>:<path> or local:<path>
OGM_BACKUP_TARGET=
# [shared] service -> API bearer (X-Ogm-Service names the caller)
OGM_INTERNAL_TOKEN=
# [api] HMAC key for gmj1 job tokens
OGM_JOB_TOKEN_SECRET=
# [api] first-start seed of the allow list; makers (optional)
OGM_ALLOWED_EMAILS=
# [api] first-start seed of the allow list as admins, and the break-glass role (optional)
OGM_MAINTAINER_EMAILS=
# [api] Google OAuth client id (optional; Google off when unset)
GOOGLE_CLIENT_ID=
# [api] Google OAuth client secret (optional)
GOOGLE_CLIENT_SECRET=
# [api] smtp(s)://user:pass@host:port (optional; admin inbox when unset)
SMTP_URL=
# [api] From address for SMTP mail (optional)
SMTP_FROM=
# [api] QA accounts whose mail stays in the admin inbox, for ops/bin/ogm-qa-signin (optional)
OGM_QA_EMAILS=
# [shared] assets-local library root for gm and intake
OGM_ASSETS_ROOT=
# [intake] ~/.local/state/ogm (intake status root)
OGM_STATE_DIR=
# [gm] platform skill-pack root used by gm skills sync
GM_SKILLS_DIR=
# [gm] JSONL file gm appends activity events to
GM_EVENTS_FILE=
# [gm] job id gm stamps on activity events
GM_JOB=
# [gm] optional local reference-game corpus for skill evals
OGM_EVAL_CORPUS=
# [gm] Aiur issue number stamped on gm activity
AIUR_HOOK_TICKET_IDENTIFIER=
# [gm] Aiur run branch stamped on gm activity
AIUR_TICKET_BRANCH=
# [gm] loopback API URL a game daemon puts blobs to
OGM_INTERNAL_URL=
# [gm] file holding the game daemon's hook secret
OGM_HOOK_SECRET_FILE=
# [shared] loopback URL of the internal API (commit, voice-host, repair)
OGM_API_INTERNAL_URL=
# [api] root of the builder agents' aiur workspaces; the build chat relay reads <ws>/.gm/outbox/*.jsonl
OGM_BUILDER_WORKSPACES_ROOT=
# [api] build chat aiur progress poll period (default 10000)
OGM_CHAT_POLL_MS=
# [api] build chat aiur decision poll period (default 5000)
OGM_CHECKPOINT_POLL_MS=
# [api] how long a New Game design Command stays open before its recommended option answers it (default 300000)
OGM_DESIGN_DEFAULT_MS=
# [commit] fixed owner/repository for platform bug reports
OGM_PLATFORM_ISSUE_REPO=
# [voice-host] loopback port of the voice host internal HTTP
OGM_VOICE_INTERNAL_PORT=
# [voice-host] fake, elevenlabs_agents or openai_realtime
OGM_VOICE_PROVIDER=
# [voice-host] ElevenLabs API key for live dictation, conversations and narration
ELEVENLABS_API_KEY=
# [voice-host] ElevenLabs hosted conversational-agent id
ELEVENLABS_AGENT_ID=
# [voice-host] durable provider-conversation cleanup queue
OGM_VOICE_CLEANUP_ROOT=
# [voice-host] model the voice provider uses (not needed for fake)
OGM_VOICE_LLM=
# [voice-host] concurrent voice conversations (default 2)
OGM_VOICE_MAX_SESSIONS=
# [voice-host] temporary WAV render directory (default system temp/ogm-voice-renders)
OGM_VOICE_RENDER_DIR=
# [voice-host] allow batch narration renders (default false; a provider key alone never renders)
OGM_VOICE_NARRATION_ENABLED=
# [api] wss://<tailnet-host>:8443/ws/voice
OGM_VOICE_WS_URL=
# [gm] gm run uses SwiftShader instead of the GPU (CI)
GM_VERIFY_SOFTWARE_GL=
# [gm] gm run hands captures to the host runner (sandbox)
GM_VERIFY_QUEUE=
# [gm] refuses operator-only gm commands inside a sandbox
OGM_SANDBOX=
# [gm] cached Chromium browsers used by gm verify
PLAYWRIGHT_BROWSERS_PATH=
# [gm] holds the ogm-verify capture slots (2 per host)
XDG_RUNTIME_DIR=
# [shared] redistribution:none hash feed (gm packs blocklist writes, commit service reads)
OGM_BLOCKLIST_FILE=
# [commit] optional HMAC secret for GitHub pull-request webhooks
OGM_GITHUB_WEBHOOK_SECRET=
# [core-bump] comma-separated owner/repository of every instance repository kept on the core
OGM_CORE_BUMP_REPOS=
# [core-bump] owner/repository of the core an instance repository pins
OGM_CORE_BUMP_CORE_REPO=
# [core-bump] core branch instances follow (default main)
OGM_CORE_BUMP_CORE_BRANCH=
# [core-bump] ~/.local/state/ogm/core-bump (scratch clones)
OGM_CORE_BUMP_WORK_DIR=
