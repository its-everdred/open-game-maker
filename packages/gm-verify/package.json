{
  "name": "@ogm/gm-verify",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./report": {
      "types": "./dist/report.d.ts",
      "default": "./dist/report.js"
    },
    "./budgets": {
      "types": "./dist/budgets.d.ts",
      "default": "./dist/budgets.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    },
    "./schemas/*": "./schemas/*"
  },
  "scripts": {
    "build": "tsc -b && node scripts/build-shell.mjs",
    "preemit": "pnpm build",
    "emit": "node scripts/emit-schema.mjs",
    "pretypecheck": "pnpm --filter @ogm/contracts --filter @ogm/config --filter @ogm/room-protocol --filter @ogm/iframe-bridge --filter @gm/host --filter @ogm/design-log build && pnpm build",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p scenarios/tsconfig.json && tsc -p shell/tsconfig.json",
    "pretest": "pnpm --filter @ogm/contracts --filter @ogm/room-protocol build && pnpm build && node scripts/emit-schema.mjs --check",
    "test": "vitest run",
    "pretest:browser": "pnpm --filter @ogm/contracts --filter @ogm/iframe-bridge --filter @gm/host build && pnpm build",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "lint": "eslint src scenarios shell",
    "scenario": "pnpm --filter @ogm/contracts --filter @ogm/config --filter @ogm/room-protocol --filter @ogm/iframe-bridge --filter @gm/host --filter @ogm/design-log --filter @gm/sdk --filter @ogm/rooms build && pnpm build && node scenarios/scenario.ts"
  },
  "dependencies": {
    "@ogm/contracts": "workspace:*",
    "playwright": "1.64.1",
    "typescript": "6.0.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@colyseus/sdk": "0.18.9",
    "@gm/host": "workspace:*",
    "@ogm/config": "workspace:*",
    "@ogm/design-log": "workspace:*",
    "@ogm/room-protocol": "workspace:*",
    "esbuild": "0.28.2"
  }
}
