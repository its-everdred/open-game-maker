{
  "name": "@ogm/contracts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "default": "./dist/browser.js"
    },
    "./assets": "./dist/assets.js",
    "./bridge": "./dist/bridge.js",
    "./game": "./dist/game.js",
    "./input": "./dist/input.js",
    "./transport": {
      "types": "./dist/transport.d.ts",
      "default": "./dist/transport.js"
    },
    "./schemas/*": "./schemas/*",
    "./fixtures/*": "./fixtures/*",
    "./scenery": "./dist/scenery.js"
  },
  "bin": {
    "validate-cards": "bin/validate-cards.mjs"
  },
  "scripts": {
    "build": "tsc -b",
    "generate": "node scripts/generate.mjs",
    "emit": "node scripts/emit-schemas.mjs",
    "check": "node scripts/generate.mjs --check && node scripts/emit-schemas.mjs --check && node scripts/check-fixtures.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "eslint src"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "json-schema-to-typescript": "16.0.0"
  }
}
