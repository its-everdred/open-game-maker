{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "target": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "scope"
            },
            "game_id": {
              "type": "string",
              "minLength": 1
            },
            "session_id": {
              "type": "string",
              "minLength": 1
            },
            "creator_id": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "kind",
            "game_id",
            "session_id",
            "creator_id"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "build"
            },
            "game_id": {
              "type": "string",
              "minLength": 1
            },
            "job_id": {
              "type": "string",
              "minLength": 1
            },
            "ticket": {
              "type": "string",
              "minLength": 1
            },
            "creator_id": {
              "type": "string",
              "minLength": 1
            },
            "command_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            }
          },
          "required": [
            "kind",
            "game_id",
            "job_id",
            "ticket",
            "creator_id"
          ],
          "additionalProperties": false
        }
      ]
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "type": "string",
      "enum": [
        "instruct",
        "ask"
      ]
    }
  },
  "required": [
    "target",
    "text",
    "idempotency_key",
    "kind"
  ],
  "additionalProperties": false,
  "$id": "https://open-game-maker-2000.local/schemas/voice.instruct.request.v1.json"
}
