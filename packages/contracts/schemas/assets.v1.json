                      "W": {
                        "type": "string",
                        "pattern": "^(?!\\/)(?!\\.\\.(?:\\/|$))(?!.*\\/\\.\\.(?:\\/|$))[^\\\\]+$",
                        "description": "Relative path inside the collection; traversal and backslashes are forbidden."
