                            "idle",
                            "walk",
                            "run",
                            "sprint",
                            "jump",
                            "fall",
                            "land",
                            "crouch",
                            "sit",
                            "attack-melee",
                            "attack-ranged",
                            "attack-kick",
                            "cast",
                            "block",
                            "hit",
                            "die",
                            "pick-up",
                            "interact",
                            "emote",
                            "hold",
                            "drive",
                            "swim",
                            "climb",
                            "other"
                          ],
                          "description": "Mapped by code from the name (synonym table), so agents can ask for 'die' whatever the vendor calls it."
                        },
                        "loop": {
                          "type": "boolean"
                        },
                        "root_motion": {
                          "type": "boolean"
                        }
                      },
                      "required": [
                        "name",
                        "duration_s"
                      ],
                      "additionalProperties": false
                    }
                  }
