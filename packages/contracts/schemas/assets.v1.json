                      "type": "string",
                      "enum": [
                        "floor",
                        "floor-detail",
                        "wall",
                        "wall-half",
                        "wall-narrow",
                        "wall-corner",
                        "wall-opening",
                        "wall-end",
                        "door",
                        "gate",
                        "stairs",
                        "column",
                        "ceiling",
                        "roof",
                        "road",
                        "road-corner",
                        "road-junction",
                        "fence",
                        "bridge",
                        "support",
                        "other"
                      ]
                    }
                  }
                },
                "required": [
                  "piece",
                  "grid_m"
                ],
                "additionalProperties": false
              },
              "geometry": {
                "type": "object",
                "properties": {
                  "bounds_m": {
                    "type": "object",
                    "properties": {
                      "min": {
                        "minItems": 3,
                        "maxItems": 3,
                        "type": "array",
                        "items": {
                          "type": "number"
                        }
                      },
                      "max": {
                        "minItems": 3,
                        "maxItems": 3,
                        "type": "array",
                        "items": {
                          "type": "number"
                        }
                      }
                    },
                    "required": [
                      "min",
                      "max"
                    ],
                    "additionalProperties": false
                  },
                  "footprint_cells": {
                    "type": "object",
