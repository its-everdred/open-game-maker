                  "nine_slice": {
                    "minItems": 4,
                    "maxItems": 4,
                    "type": "array",
                    "items": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    "description": "UI panels: left, top, right, bottom insets in px."
