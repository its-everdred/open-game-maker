          "tris": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "gpuTexMB": {
            "type": "number",
            "minimum": 0
          },
          "decoders": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "meshopt",
                "draco",
                "ktx2"
              ]
            }
          }
        },
        "required": [
          "bytes",
          "decoders"
        ],
        "additionalProperties": {}
      }
    },
    "assets": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "phase": {
            "type": "string",
            "pattern": "^(?:boot|lazy:[a-z0-9]+(?:[._-][a-z0-9]+)*)$"
