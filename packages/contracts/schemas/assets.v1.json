                          "minProperties": 1,
                          "type": "object",
                          "properties": {
                            "E": {
                              "minItems": 1,
                              "type": "array",
                              "items": {
                                "type": "string",
                                "pattern": "^(?!\\/)(?!\\.\\.(?:\\/|$))(?!.*\\/\\.\\.(?:\\/|$))[^\\\\]+$",
                                "description": "Relative path inside the collection; traversal and backslashes are forbidden."
                              }
                            },
                            "N": {
                              "minItems": 1,
                              "type": "array",
                              "items": {
                                "type": "string",
                                "pattern": "^(?!\\/)(?!\\.\\.(?:\\/|$))(?!.*\\/\\.\\.(?:\\/|$))[^\\\\]+$",
                                "description": "Relative path inside the collection; traversal and backslashes are forbidden."
                              }
                            },
                            "NE": {
                              "minItems": 1,
                              "type": "array",
                              "items": {
                                "type": "string",
                                "pattern": "^(?!\\/)(?!\\.\\.(?:\\/|$))(?!.*\\/\\.\\.(?:\\/|$))[^\\\\]+$",
                                "description": "Relative path inside the collection; traversal and backslashes are forbidden."
                              }
                            },
                            "NW": {
                              "minItems": 1,
                              "type": "array",
                              "items": {
                                "type": "string",
                                "pattern": "^(?!\\/)(?!\\.\\.(?:\\/|$))(?!.*\\/\\.\\.(?:\\/|$))[^\\\\]+$",
                                "description": "Relative path inside the collection; traversal and backslashes are forbidden."
                              }
                            },
                            "S": {
                              "minItems": 1,
                              "type": "array",
                              "items": {
                                "type": "string",
                                "pattern": "^(?!\\/)(?!\\.\\.(?:\\/|$))(?!.*\\/\\.\\.(?:\\/|$))[^\\\\]+$",
                                "description": "Relative path inside the collection; traversal and backslashes are forbidden."
                              }
                            },
                            "SE": {
                              "minItems": 1,
                              "type": "array",
                              "items": {
                                "type": "string",
                                "pattern": "^(?!\\/)(?!\\.\\.(?:\\/|$))(?!.*\\/\\.\\.(?:\\/|$))[^\\\\]+$",
                                "description": "Relative path inside the collection; traversal and backslashes are forbidden."
                              }
                            },
                            "SW": {
                              "minItems": 1,
                              "type": "array",
                              "items": {
                                "type": "string",
                                "pattern": "^(?!\\/)(?!\\.\\.(?:\\/|$))(?!.*\\/\\.\\.(?:\\/|$))[^\\\\]+$",
                                "description": "Relative path inside the collection; traversal and backslashes are forbidden."
                              }
                            },
                            "W": {
                              "minItems": 1,
                              "type": "array",
                              "items": {
                                "type": "string",
                                "pattern": "^(?!\\/)(?!\\.\\.(?:\\/|$))(?!.*\\/\\.\\.(?:\\/|$))[^\\\\]+$",
                                "description": "Relative path inside the collection; traversal and backslashes are forbidden."
                              }
                            }
                          },
                          "additionalProperties": false
                        }
                      },
                      "required": [
                        "name",
                        "frames"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "facings": {
                    "minProperties": 1,
                    "type": "object",
                    "properties": {
                      "E": {
                        "type": "string",
                        "pattern": "^(?!\\/)(?!\\.\\.(?:\\/|$))(?!.*\\/\\.\\.(?:\\/|$))[^\\\\]+$",
                        "description": "Relative path inside the collection; traversal and backslashes are forbidden."
                      },
                      "N": {
                        "type": "string",
                        "pattern": "^(?!\\/)(?!\\.\\.(?:\\/|$))(?!.*\\/\\.\\.(?:\\/|$))[^\\\\]+$",
                        "description": "Relative path inside the collection; traversal and backslashes are forbidden."
                      },
                      "NE": {
                        "type": "string",
                        "pattern": "^(?!\\/)(?!\\.\\.(?:\\/|$))(?!.*\\/\\.\\.(?:\\/|$))[^\\\\]+$",
                        "description": "Relative path inside the collection; traversal and backslashes are forbidden."
                      },
                      "NW": {
                        "type": "string",
                        "pattern": "^(?!\\/)(?!\\.\\.(?:\\/|$))(?!.*\\/\\.\\.(?:\\/|$))[^\\\\]+$",
                        "description": "Relative path inside the collection; traversal and backslashes are forbidden."
                      },
                      "S": {
                        "type": "string",
                        "pattern": "^(?!\\/)(?!\\.\\.(?:\\/|$))(?!.*\\/\\.\\.(?:\\/|$))[^\\\\]+$",
                        "description": "Relative path inside the collection; traversal and backslashes are forbidden."
                      },
                      "SE": {
                        "type": "string",
                        "pattern": "^(?!\\/)(?!\\.\\.(?:\\/|$))(?!.*\\/\\.\\.(?:\\/|$))[^\\\\]+$",
                        "description": "Relative path inside the collection; traversal and backslashes are forbidden."
                      },
                      "SW": {
                        "type": "string",
                        "pattern": "^(?!\\/)(?!\\.\\.(?:\\/|$))(?!.*\\/\\.\\.(?:\\/|$))[^\\\\]+$",
                        "description": "Relative path inside the collection; traversal and backslashes are forbidden."
