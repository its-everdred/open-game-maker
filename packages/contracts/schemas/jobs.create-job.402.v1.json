{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "error": {
      "type": "string",
      "enum": [
        "allowance_exceeded",
        "platform_cap_reached",
        "energy_limit_reached"
      ]
    },
    "remainingMicroUsd": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "resetsAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "offers": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "trim",
          "split",
          "queue",
          "ask_admin"
        ]
      }
    },
    "window": {
      "type": "string",
      "enum": [
        "day",
        "week",
        "month"
      ]
    }
  },
  "required": [
    "error",
    "remainingMicroUsd",
    "resetsAt",
    "offers"
  ],
  "additionalProperties": false,
  "$id": "https://open-game-maker-2000.local/schemas/jobs.create-job.402.v1.json"
}
