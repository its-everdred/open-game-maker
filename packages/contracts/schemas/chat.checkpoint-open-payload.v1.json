{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "checkpoint_id": {
      "type": "string",
      "pattern": "^cp_[0-7][0-9A-HJKMNP-TV-Z]{25}$"
    },
    "question": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8000
    },
    "options": {
      "minItems": 2,
      "maxItems": 12,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9_-]{1,32}$"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "media_id": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[a-z]{1,3}_[0-9a-f-]{36}$"
              },
              {
                "type": "string",
                "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$"
              }
            ]
          },
          "provenance": {
            "type": "object",
            "properties": {
              "packs": {
                "default": [],
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                }
              },
              "assets": {
                "default": [],
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                }
              },
              "generator": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "built_at": {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
              },
              "aspect": {
                "type": "string",
                "enum": [
                  "characters",
                  "look",
                  "options",
                  "scene",
                  "hud",
                  "other"
                ]
              },
              "kind": {
                "type": "string",
                "enum": [
                  "stand-in",
                  "render",
                  "screenshot",
                  "clip",
                  "mockup"
                ]
              },
              "view": {
                "type": "string",
                "enum": [
                  "player",
                  "off-camera",
                  "other"
                ]
              }
            },
            "required": [
              "packs",
              "assets",
              "generator",
              "built_at"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "label"
        ],
        "additionalProperties": false
      }
    },
    "recommend": {
      "type": "string",
      "pattern": "^[a-z0-9_-]{1,32}$"
    },
    "blocking": {
      "type": "boolean"
    },
    "pick": {
      "type": "string",
      "enum": [
        "one",
        "many"
      ]
    }
  },
  "required": [
    "checkpoint_id",
    "question",
    "options",
    "blocking"
  ],
  "additionalProperties": false,
  "$id": "https://open-game-maker-2000.local/schemas/chat.checkpoint-open-payload.v1.json"
}
