{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "drafts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.:-]{1,240}$"
          },
          "deck": {
            "type": "object",
            "properties": {
              "cards": {
                "maxItems": 12,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "option_id": {
                      "type": "string",
                      "pattern": "^[a-z0-9_-]{1,32}$"
                    },
                    "verdict": {
                      "type": "string",
                      "enum": [
                        "like",
                        "dislike"
                      ]
                    },
                    "reason": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 1000
                    }
                  },
                  "required": [
                    "option_id",
                    "verdict"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "cards"
            ],
            "additionalProperties": false
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
          }
        },
        "required": [
          "key",
          "deck",
          "updated_at"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "drafts"
  ],
  "additionalProperties": false,
  "$id": "https://open-game-maker-2000.local/schemas/commands.review-drafts.v1.json"
}
