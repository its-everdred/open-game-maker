{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^D-[0-9]{2,}$"
          },
          "game_id": {
            "type": "string",
            "pattern": "^[a-z]{1,3}_[0-9a-f-]{36}$"
          },
          "job_id": {
            "type": "string",
            "pattern": "^[a-z]{1,3}_[0-9a-f-]{36}$"
          },
          "ticket": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 40
              },
              {
                "type": "null"
              }
            ]
          },
          "checkpoint_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "decision_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "question": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8000
          },
          "options": {
            "minItems": 2,
            "maxItems": 12,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-z0-9_-]{1,32}$"
                },
                "label": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                }
              },
              "required": [
                "id",
                "label"
              ],
              "additionalProperties": false
            }
          },
          "recommended": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[a-z0-9_-]{1,32}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "chosen": {
            "type": "string",
            "pattern": "^[a-z0-9_-]{1,32}$"
          },
          "origin": {
            "type": "string",
            "enum": [
              "player",
              "default"
            ]
          },
          "skipped": {
            "type": "boolean"
          },
          "affects": {
            "maxItems": 20,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            }
          },
          "supersedes": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^D-[0-9]{2,}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "at": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
          }
        },
        "required": [
          "id",
          "game_id",
          "job_id",
          "ticket",
          "checkpoint_id",
          "decision_id",
          "question",
          "options",
          "recommended",
          "chosen",
          "origin",
          "skipped",
          "affects",
          "supersedes",
          "at"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "decisions"
  ],
  "additionalProperties": false,
  "$id": "https://open-game-maker-2000.local/schemas/design-decisions.history.v1.json"
}
