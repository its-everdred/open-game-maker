{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "level": {
      "type": "string",
      "enum": [
        "healthy",
        "limited",
        "critical",
        "unknown"
      ]
    },
    "preference": {
      "type": "string",
      "enum": [
        "save",
        "balanced",
        "best"
      ]
    },
    "windows": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "window": {
            "type": "string",
            "enum": [
              "day",
              "week",
              "month"
            ]
          },
          "usedPercent": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0,
                "maximum": 100
              },
              {
                "type": "null"
              }
            ]
          },
          "resetsAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
          }
        },
        "required": [
          "window",
          "usedPercent",
          "resetsAt"
        ],
        "additionalProperties": false
      }
    },
    "services": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "service": {
            "type": "string",
            "enum": [
              "voice",
              "images"
            ]
          },
          "usedPercent": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0,
                "maximum": 100
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "service",
          "usedPercent"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "level",
    "preference",
    "windows",
    "services"
  ],
  "additionalProperties": false,
  "$id": "https://open-game-maker-2000.local/schemas/energy.view.v1.json"
}
