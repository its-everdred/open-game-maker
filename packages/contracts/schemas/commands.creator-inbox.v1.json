{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "commands": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "job_id": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[a-z]{1,3}_[0-9a-f-]{36}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "ticket": {
            "type": [
              "string",
              "null"
            ]
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "summary": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "checkpoint_id": {
            "type": "string"
          },
          "decision_id": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "question": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8000
          },
          "options": {
            "minItems": 2,
            "maxItems": 12,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-z0-9_-]{1,32}$"
                },
                "label": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                "media": {
                  "type": "object",
                  "properties": {
                    "url": {
                      "type": "string",
                      "format": "uri"
                    },
                    "poster": {
                      "type": "string",
                      "format": "uri"
                    },
                    "width": {
                      "type": "integer",
                      "exclusiveMinimum": 0,
                      "maximum": 9007199254740991
                    },
                    "height": {
                      "type": "integer",
                      "exclusiveMinimum": 0,
                      "maximum": 9007199254740991
                    },
                    "duration_ms": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    }
                  },
                  "required": [
                    "url",
                    "width",
                    "height"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
                "id",
                "label"
              ],
              "additionalProperties": false
            }
          },
          "recommend": {
            "type": "string"
          },
          "blocking": {
            "type": "boolean"
          },
          "pick": {
            "type": "string",
            "enum": [
              "one",
              "many"
            ]
          },
          "opened_at": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
          },
          "review_number": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "game_id": {
            "type": "string",
            "pattern": "^[a-z]{1,3}_[0-9a-f-]{36}$"
          },
          "game_title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        },
        "required": [
          "job_id",
          "ticket",
          "title",
          "checkpoint_id",
          "decision_id",
          "version",
          "question",
          "options",
          "blocking",
          "opened_at",
          "game_id",
          "game_title"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "commands"
  ],
  "additionalProperties": false,
  "$id": "https://open-game-maker-2000.local/schemas/commands.creator-inbox.v1.json"
}
