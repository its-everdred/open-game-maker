{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "remainingMicroUsd": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "remainingPercent": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "unitLabel": {
      "type": "string"
    },
    "resetsAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "freeSlots": {
      "type": "object",
      "properties": {
        "new_game": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "edit": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "new_game",
        "edit"
      ],
      "additionalProperties": false
    },
    "queued": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z]{1,3}_[0-9a-f-]{36}$"
      }
    },
    "dailyLimitActive": {
      "type": "boolean"
    },
    "weeklyJobs": {
      "type": "object",
      "properties": {
        "newGames": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "edits": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "resetsAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        }
      },
      "required": [
        "newGames",
        "edits",
        "resetsAt"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "remainingMicroUsd",
    "remainingPercent",
    "unitLabel",
    "resetsAt",
    "freeSlots",
    "queued"
  ],
  "additionalProperties": false,
  "$id": "https://open-game-maker-2000.local/schemas/budget.status.v1.json"
}
