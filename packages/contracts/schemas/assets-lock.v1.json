                  "public"
                ]
              },
              "redistribution": {
                "type": "string",
                "enum": [
                  "none",
                  "in-build",
                  "free"
                ]
              },
              "attribution": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "uses",
              "audience",
              "redistribution",
              "attribution"
            ],
            "additionalProperties": {}
          },
          "credit": {
            "type": "object",
            "properties": {
              "pack": {
                "type": "string",
                "minLength": 1
              },
              "title": {
                "type": "string",
                "minLength": 1
              },
              "licenseSource": {
                "type": "string",
                "minLength": 1
              },
              "attribution": {
                "type": "string",
                "minLength": 1
              },
