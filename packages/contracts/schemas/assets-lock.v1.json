        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^(?:t[12]:[a-z0-9][a-z0-9-]*\\/[a-z0-9][a-z0-9/._-]*@[A-Za-z0-9._-]+|t3:[A-Za-z0-9][A-Za-z0-9_-]*\\/[a-z0-9][a-z0-9/._-]*)$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string",
            "enum": [
              "library",
              "blob",
              "vendored"
            ]
          },
          "files": {
            "type": "array",
