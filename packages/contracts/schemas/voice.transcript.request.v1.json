{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "target": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "scope"
            },
            "game_id": {
              "type": "string",
              "minLength": 1
            },
            "session_id": {
              "type": "string",
              "minLength": 1
            },
            "creator_id": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "kind",
            "game_id",
            "session_id",
            "creator_id"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "build"
            },
            "game_id": {
              "type": "string",
              "minLength": 1
            },
            "job_id": {
              "type": "string",
              "minLength": 1
            },
            "ticket": {
              "type": "string",
              "minLength": 1
            },
            "creator_id": {
              "type": "string",
              "minLength": 1
            },
            "command_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            }
          },
          "required": [
            "kind",
            "game_id",
            "job_id",
            "ticket",
            "creator_id"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "questions"
            },
            "game_id": {
              "type": "string",
              "minLength": 1
            },
            "creator_id": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "kind",
            "game_id",
            "creator_id"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "edit"
            },
            "game_id": {
              "type": "string",
              "minLength": 1
            },
            "creator_id": {
              "type": "string",
              "minLength": 1
            },
            "session_id": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            },
            "job_id": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "kind",
            "game_id",
            "creator_id",
            "session_id"
          ],
          "additionalProperties": false
        }
      ]
    },
    "conversation_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "turn_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "actor": {
      "type": "string",
      "enum": [
        "creator",
        "agent"
      ]
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8000
    }
  },
  "required": [
    "target",
    "conversation_id",
    "turn_id",
    "actor",
    "text"
  ],
  "additionalProperties": false,
  "$id": "https://open-game-maker-2000.local/schemas/voice.transcript.request.v1.json"
}
