{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "kind": {
      "type": "string",
      "const": "question_answers"
    },
    "answers": {
      "maxItems": 12,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "option_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32
          },
          "verdict": {
            "type": "string",
            "enum": [
              "like",
              "dislike"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          }
        },
        "required": [
          "option_id",
          "verdict"
        ],
        "additionalProperties": false
      }
    },
    "notes": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    }
  },
  "required": [
    "kind",
    "answers"
  ],
  "additionalProperties": false,
  "$id": "https://open-game-maker-2000.local/schemas/commands.review-answer-payload.v1.json"
}
