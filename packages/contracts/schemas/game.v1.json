{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "sdk": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "hostOrigin": {
      "type": "string",
      "format": "uri",
      "pattern": "^https?:\\/\\/[^/?#@]+$"
    },
    "inputs": {
      "type": "object",
      "properties": {
        "actions": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32
          },
          "additionalProperties": {
            "type": "string",
            "enum": [
              "button",
              "axis",
              "stick"
            ]
          }
        }
      },
      "required": [
        "actions"
      ],
      "additionalProperties": {}
    },
    "presentation": {
      "type": "object",
      "properties": {
        "orientation": {
          "type": "string",
          "enum": [
            "landscape",
            "portrait",
            "any"
          ]
        },
        "minLogical": {
          "type": "object",
          "properties": {
            "w": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "h": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          },
          "required": [
            "w",
            "h"
          ],
          "additionalProperties": {}
        },
        "fit": {
          "type": "string",
          "enum": [
            "responsive",
            "fixed"
          ]
        }
      },
      "required": [
        "orientation",
        "minLogical",
        "fit"
      ],
      "additionalProperties": {}
    },
    "view": {
      "type": "string",
      "enum": [
        "iso",
        "topdown",
        "side",
        "follow",
        "fps",
        "orbit",
        "fixed"
      ]
    },
    "dimension": {
      "type": "string",
      "enum": [
        "2d",
        "3d"
      ]
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "palette": {
      "type": "object",
      "properties": {
        "categories": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "kind": {
                "type": "string",
                "enum": [
                  "items",
                  "tools",
                  "panel"
                ]
              }
            },
            "required": [
              "id",
              "label",
              "kind"
            ],
            "additionalProperties": {}
          }
        },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "prefab": {
                "type": "string",
                "minLength": 1
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "thumbnail": {
                "type": "string"
              },
              "tag": {
                "type": "string",
                "minLength": 1,
                "maxLength": 32
              },
              "aiGenerated": {
                "type": "boolean"
              },
              "hint": {
                "type": "string",
                "maxLength": 200
              },
              "category": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "prefab",
              "label",
              "category"
            ],
            "additionalProperties": {}
          }
        }
      },
      "required": [
        "categories",
        "items"
      ],
      "additionalProperties": {}
    },
    "tools": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "select",
          "place",
          "brush",
          "sculpt",
          "erase",
          "path"
        ]
      }
    },
    "gizmos": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string",
          "enum": [
            "translate",
            "rotateYaw",
            "elevate",
            "splinePoints"
          ]
        }
      }
    },
    "grid": {
      "type": "object",
      "properties": {
        "size": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "units": {
          "type": "string",
          "maxLength": 16
        }
      },
      "required": [
        "size",
        "units"
      ],
      "additionalProperties": {}
    },
    "playLabel": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "controlBindings": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64
      }
    },
    "controlReservedKeys": {
      "maxItems": 64,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64
      }
    },
    "gameOptions": {
      "maxItems": 20,
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_-]{0,63}$"
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "kind": {
                "type": "string",
                "const": "toggle"
              },
              "default": {
                "type": "boolean"
              }
            },
            "required": [
              "id",
              "label",
              "kind",
              "default"
            ],
            "additionalProperties": {}
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_-]{0,63}$"
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "kind": {
                "type": "string",
                "const": "choice"
              },
              "default": {
                "type": "string",
                "maxLength": 64
              },
              "choices": {
                "minItems": 1,
                "maxItems": 20,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "value": {
                      "type": "string",
                      "maxLength": 64
                    },
                    "label": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 200
                    }
                  },
                  "required": [
                    "value",
                    "label"
                  ],
                  "additionalProperties": {}
                }
              }
            },
            "required": [
              "id",
              "label",
              "kind",
              "default",
              "choices"
            ],
            "additionalProperties": {}
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_-]{0,63}$"
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "kind": {
                "type": "string",
                "const": "number"
              },
              "default": {
                "type": "number"
              },
              "min": {
                "type": "number"
              },
              "max": {
                "type": "number"
              },
              "step": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            },
            "required": [
              "id",
              "label",
              "kind",
              "default",
              "min",
              "max",
              "step"
            ],
            "additionalProperties": {}
          }
        ]
      }
    },
    "playMenuButton": {
      "type": "object",
      "properties": {
        "colour": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "icon": {
          "type": "string",
          "enum": [
            "pause",
            "menu"
          ]
        }
      },
      "required": [
        "colour",
        "icon"
      ],
      "additionalProperties": {}
    },
    "saves": {
      "type": "boolean"
    },
    "saveSchema": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "migratesFrom": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "net": {
      "type": "object",
      "properties": {
        "authority": {
          "type": "string",
          "enum": [
            "per-seat",
            "host",
            "rollback"
          ]
        },
        "maxSeats": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8
        },
        "inputDelayTicks": {
          "type": "integer",
          "minimum": 2,
          "maximum": 8
        },
        "seatStateHz": {
          "type": "integer",
          "minimum": 1,
          "maximum": 30
        },
        "spectators": {
          "type": "string",
          "enum": [
            "off",
            "on"
          ]
        },
        "forfeit": {
          "type": "string",
          "enum": [
            "continue",
            "skip",
            "surrender"
          ]
        }
      },
      "required": [
        "maxSeats"
      ],
      "additionalProperties": false
    },
    "overrides": {
      "type": "object",
      "properties": {
        "aliases": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "string"
          }
        },
        "retired": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "migrate": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "aliases",
        "retired"
      ],
      "additionalProperties": {}
    }
  },
  "required": [
    "id",
    "sdk",
    "title",
    "inputs",
    "presentation",
    "view",
    "dimension",
    "capabilities",
    "palette",
    "tools",
    "gizmos",
    "saves",
    "overrides"
  ],
  "additionalProperties": {},
  "$id": "https://open-game-maker-2000.local/schemas/game.v1.json"
}
