{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "id": {
        "type": "string",
        "minLength": 1,
        "maxLength": 80
      },
      "area": {
        "type": "string",
        "minLength": 1,
        "maxLength": 120
      },
      "question": {
        "type": "string",
        "minLength": 1,
        "maxLength": 120
      },
      "why": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      },
      "options": {
        "minItems": 2,
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "label": {
              "type": "string",
              "minLength": 1
            },
            "media": {
              "type": "string",
              "minLength": 1
            },
            "media_needed": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "label"
          ],
          "additionalProperties": false
        }
      },
      "recommendation": {
        "type": "string",
        "minLength": 1
      },
      "sources": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        }
      },
      "phase": {
        "type": "string",
        "enum": [
          "mock",
          "prototype",
          "build",
          "polish"
        ]
      },
      "ticket": {
        "anyOf": [
          {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          {
            "type": "null"
          }
        ]
      },
      "status": {
        "type": "string",
        "enum": [
          "open",
          "asked",
          "answered",
          "defaulted"
        ]
      },
      "answer": {
        "anyOf": [
          {
            "type": "string",
            "minLength": 1
          },
          {
            "type": "null"
          }
        ]
      },
      "answered_at": {
        "anyOf": [
          {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
          },
          {
            "type": "null"
          }
        ]
      }
    },
    "required": [
      "id",
      "area",
      "question",
      "why",
      "options",
      "recommendation",
      "sources",
      "ticket",
      "status",
      "answer",
      "answered_at"
    ],
    "additionalProperties": false
  },
  "$id": "https://open-game-maker-2000.local/schemas/decision-inventory.v1.json"
}
