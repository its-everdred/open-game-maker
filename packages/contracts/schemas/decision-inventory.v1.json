{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "id": {
        "type": "string",
        "minLength": 1,
        "maxLength": 80
      },
      "command_id": {
        "anyOf": [
          {
            "type": "string",
            "pattern": "^cp_[0-7][0-9A-HJKMNP-TV-Z]{25}$"
          },
          {
            "type": "null"
          }
        ]
      },
      "area": {
        "type": "string",
        "minLength": 1,
        "maxLength": 120
      },
      "question": {
        "type": "string",
        "minLength": 1,
        "maxLength": 120
      },
      "why": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      },
      "options": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "label": {
              "type": "string",
              "minLength": 1
            },
            "media": {
              "type": "string",
              "minLength": 1
            },
            "media_needed": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "label"
          ],
          "additionalProperties": false
        }
      },
      "recommendation": {
        "type": "string",
        "minLength": 1
      },
      "sources": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        }
      },
      "phase": {
        "type": "string",
        "enum": [
          "mock",
          "prototype",
          "build",
          "polish"
        ]
      },
      "ticket": {
        "anyOf": [
          {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          {
            "type": "null"
          }
        ]
      },
      "status": {
        "type": "string",
        "enum": [
          "open",
          "asked",
          "answered",
          "defaulted"
        ]
      },
      "answer": {
        "default": null,
        "anyOf": [
          {
            "type": "string",
            "minLength": 1
          },
          {
            "type": "null"
          }
        ]
      },
      "answered_at": {
        "default": null,
        "anyOf": [
          {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
              },
              {
                "type": "string",
                "format": "date",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
              }
            ]
          },
          {
            "type": "null"
          }
        ]
      },
      "reuse": {
        "type": "object",
        "properties": {
          "paths": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "generator": {
            "type": "string",
            "minLength": 1
          },
          "notes": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        },
        "required": [
          "paths"
        ],
        "additionalProperties": false
      }
    },
    "required": [
      "id",
      "area",
      "question",
      "why",
      "options",
      "recommendation",
      "sources",
      "ticket",
      "status"
    ],
    "additionalProperties": {},
    "allOf": [
      {
        "if": {
          "required": [
            "mode"
          ],
          "properties": {
            "mode": {
              "type": "string"
            }
          }
        },
        "else": {
          "if": {
            "required": [
              "status"
            ],
            "properties": {
              "status": {
                "const": "answered"
              }
            }
          },
          "then": {
            "properties": {
              "options": {
                "type": "array",
                "minItems": 1
              }
            }
          },
          "else": {
            "properties": {
              "options": {
                "type": "array",
                "minItems": 2
              }
            }
          }
        }
      }
    ]
  },
  "$id": "https://open-game-maker-2000.local/schemas/decision-inventory.v1.json"
}
