{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-z]{1,3}_[0-9a-f-]{36}$"
        },
        {
          "type": "string",
          "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$"
        }
      ]
    },
    "job_id": {
      "type": "string",
      "pattern": "^[a-z]{1,3}_[0-9a-f-]{36}$"
    },
    "at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "actor": {
      "type": "string",
      "enum": [
        "creator",
        "agent",
        "system"
      ]
    },
    "kind": {
      "type": "string",
      "enum": [
        "text",
        "image",
        "clip",
        "checkpoint",
        "progress"
      ]
    },
    "text": {
      "type": "string"
    },
    "media": {
      "type": "object",
      "properties": {
        "url": {
          "type": "string",
          "format": "uri"
        },
        "poster": {
          "type": "string",
          "format": "uri"
        },
        "width": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "height": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "duration_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "url",
        "width",
        "height"
      ],
      "additionalProperties": false
    },
    "checkpoint": {
      "type": "object",
      "properties": {
        "decision_id": {
          "type": "string"
        },
        "question": {
          "type": "string"
        },
        "options": {
          "maxItems": 12,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "label": {
                "type": "string"
              },
              "media_id": {
                "type": "string"
              },
              "provenance": {
                "type": "object",
                "properties": {
                  "packs": {
                    "default": [],
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 200
                    }
                  },
                  "assets": {
                    "default": [],
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 200
                    }
                  },
                  "generator": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  },
                  "built_at": {
                    "type": "string",
                    "format": "date-time",
                    "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
                  },
                  "aspect": {
                    "type": "string",
                    "enum": [
                      "characters",
                      "look",
                      "options",
                      "scene",
                      "hud",
                      "other"
                    ]
                  },
                  "kind": {
                    "type": "string",
                    "enum": [
                      "stand-in",
                      "render",
                      "screenshot",
                      "clip",
                      "mockup"
                    ]
                  },
                  "view": {
                    "type": "string",
                    "enum": [
                      "player",
                      "off-camera",
                      "other"
                    ]
                  }
                },
                "required": [
                  "packs",
                  "assets",
                  "generator",
                  "built_at"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "id",
              "label"
            ],
            "additionalProperties": false
          }
        },
        "recommend": {
          "type": "string"
        },
        "blocking": {
          "type": "boolean"
        },
        "pick": {
          "type": "string",
          "enum": [
            "one",
            "many"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "open",
            "answered",
            "moot"
          ]
        },
        "option_id": {
          "type": "string"
        },
        "review": {
          "type": "object",
          "properties": {
            "likes": {
              "maxItems": 12,
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[a-z0-9_-]{1,32}$"
              }
            },
            "dislikes": {
              "maxItems": 12,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "option_id": {
                    "type": "string",
                    "pattern": "^[a-z0-9_-]{1,32}$"
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1000
                  }
                },
                "required": [
                  "option_id"
                ],
                "additionalProperties": false
              }
            },
            "notes": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000
            }
          },
          "required": [
            "likes",
            "dislikes"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "decision_id",
        "question",
        "options",
        "status"
      ],
      "additionalProperties": false
    },
    "attachments": {
      "maxItems": 8,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z]{1,3}_[0-9a-f-]{36}$"
          },
          "kind": {
            "type": "string",
            "enum": [
              "image",
              "text"
            ]
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "mime": {
            "type": "string",
            "enum": [
              "image/webp",
              "text/plain",
              "text/markdown",
              "application/json"
            ]
          },
          "bytes": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 10485760
          }
        },
        "required": [
          "id",
          "kind",
          "name",
          "mime",
          "bytes"
        ],
        "additionalProperties": false
      }
    },
    "aiur": {
      "type": "object",
      "properties": {
        "ticket": {
          "type": "string"
        },
        "event_id": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "topic": {
          "type": "string"
        }
      },
      "required": [
        "ticket"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "id",
    "job_id",
    "at",
    "actor",
    "kind"
  ],
  "additionalProperties": false,
  "$id": "https://open-game-maker-2000.local/schemas/chat.message.v1.json"
}
