{
  "name": "@ogm/gm-cli",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "bin": {
    "gm": "dist/index.js"
  },
  "types": "./dist/cli.d.ts",
  "exports": {
    ".": {
      "types": "./dist/cli.d.ts",
      "default": "./dist/cli.js"
    },
    "./card-format": {
      "types": "./dist/skills/card-format.d.ts",
      "default": "./dist/skills/card-format.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "pretypecheck": "pnpm --filter @ogm/contracts --filter @ogm/config --filter @ogm/asset-cards --filter @ogm/asset-measure --filter @ogm/blob-store --filter @ogm/game-repo-template --filter @ogm/gm-verify build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest": "pnpm --filter @ogm/contracts --filter @ogm/iframe-bridge --filter @gm/sdk --filter @ogm/config --filter @ogm/asset-cards --filter @ogm/asset-measure --filter @ogm/blob-store --filter @ogm/game-repo-template --filter @ogm/gm-verify build",
    "test": "vitest run",
    "lint": "eslint src"
  },
  "dependencies": {
    "@gltf-transform/core": "4.5.1",
    "@gltf-transform/extensions": "4.5.1",
    "@gltf-transform/functions": "4.5.1",
    "@gm/sdk": "workspace:*",
    "@ogm/asset-cards": "workspace:*",
    "@ogm/asset-measure": "workspace:*",
    "@ogm/blob-store": "workspace:*",
    "@ogm/config": "workspace:*",
    "@ogm/contracts": "workspace:*",
    "@ogm/game-repo-template": "workspace:*",
    "@ogm/gm-verify": "workspace:*",
    "adm-zip": "0.6.1",
    "esbuild": "0.28.2",
    "meshoptimizer": "1.3.0",
    "sharp": "0.35.5",
    "tar": "7.5.22",
    "three": "0.186.1",
    "ulid": "3.0.2",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/three": "0.186.0"
  }
}
