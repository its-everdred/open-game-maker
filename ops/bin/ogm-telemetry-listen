#!/usr/bin/env python3
"""OGM telemetry listener (#1318): tell the Executor within a minute when a game crashes or someone opens the app.

The app shell posts crashes, app opens and play heartbeats to POST /api/v1/telemetry/client-events, which groups crashes
by (game, build, signature) in SQLite. Every --interval seconds this reads the database read-only and, for what is new
since its last pass:
  - each new crash group appends one attention line, and opens one issue per new signature (priority:1, deduplicated:
    the same signature in a new build comments on the existing issue). A crash in a published build names the release,
    its git tag and the merged PR that carried its commit. Crashes naming no known game get no issue, and GitHub
    writes are capped at 10 an hour: any signed-in account can post crashes.
  - each app open appends one attention line with who, device, domain and app version, plus the crash groups seen in the
    last day, so background agents can check the live path before the player gets there. Opens from a headless
    browser (the post-deploy play check) are skipped; their crashes are not.
The attention file is the one the Executor's listener watches (HS_ATTENTION, then OGM_QA_ATTENTION). The first pass
with no state file starts from now: history is not replayed.

usage: ogm-telemetry-listen [--db <ogm.sqlite3>] [--state <file>] [--attention <file>] [--repo <owner/name>]
                            [--interval <s>] [--once] [--no-issues]
       ogm-telemetry-listen stats [--db <ogm.sqlite3>] [--days <n>]
  --state      cursor and filed issues (default: $OGM_STATE_DIR or ~/.local/state/ogm, telemetry-listen.json)
  --repo       where crash issues go (default: $OGM_TELEMETRY_REPO or its-everdred/open-game-maker)
  --once       one pass, then exit (tests, cron)
  --no-issues  attention lines only
  stats        per game and build over the last --days (default 7): sessions, crashes, first-frame and in-world rates
exit 0 ok; 64 bad usage; 70 a pass failed (printed; the service restarts it).
"""

import json
import os
import re
import sqlite3
import subprocess
import sys
import time
from datetime import datetime, timedelta, timezone

DEFAULT_REPO = 'its-everdred/open-game-maker'
ISSUE_LABELS = ['priority:1']
# Any signed-in account can post crashes, so GitHub writes (issues and comments) are capped; the rest stay attention lines.
GITHUB_WRITES_PER_HOUR = 10


def env_file(path):
    values = {}
    try:
        with open(path) as handle:
            for line in handle:
                if '=' in line and not line.lstrip().startswith('#'):
                    key, value = line.split('=', 1)
                    values[key.strip()] = value.strip().strip('"')
    except FileNotFoundError:
        pass
    return values


def clean(text, limit=300):
    """Client-sent text is untrusted: one line, no control characters, bounded, so it cannot forge attention lines. No
    backticks (it cannot leave a code span) and no bare @ (it cannot mention anyone on GitHub)."""
    text = re.sub(r'[\x00-\x1f\x7f]+', ' ', str(text if text is not None else ''))[:limit]
    return text.replace('`', "'").replace('@', '@\u200b')


def web_origin(text):
    """The origin the client claims, only if it is one: anything else could be a link or text in an issue."""
    text = str(text or '')
    return text if re.fullmatch(r'https?://[a-z0-9.-]+(:\d{1,5})?', text, re.I) else 'an unknown origin'


def fenced(text, limit=4000):
    """Untrusted text for an issue body: inside a code fence (no mentions, no markdown), unable to close the fence."""
    return '```\n' + str(text or '').replace('`', "'")[:limit] + '\n```'


def device_name(agent):
    """A short device and browser for a line; the full user agent goes in the issue."""
    agent = agent or ''
    device = next((name for name in ('iPhone', 'iPad', 'Android', 'Mac', 'Windows', 'Linux', 'CrOS') if name in agent),
                  'unknown device')
    browser = next((name for key, name in (('Edg/', 'Edge'), ('CriOS', 'Chrome'), ('FxiOS', 'Firefox'),
                                            ('Firefox/', 'Firefox'), ('Chrome/', 'Chrome'), ('Safari/', 'Safari'))
                    if key in agent), 'browser')
    return f'{device} {browser}'


def stamp(now):
    return now.strftime('%H:%MZ')


def load_state(path):
    try:
        with open(path) as handle:
            state = json.load(handle)
    except (FileNotFoundError, json.JSONDecodeError):
        return None
    state.setdefault('issues', {})
    state.setdefault('pending', [])
    state.setdefault('writes', [])
    return state


def save_state(path, state):
    os.makedirs(os.path.dirname(path) or '.', exist_ok=True)
    temp = f'{path}.tmp'
    with open(temp, 'w') as handle:
        json.dump(state, handle, indent=1, sort_keys=True)
    os.replace(temp, path)


def append_attention(path, lines):
    if not path or not lines:
        return
    with open(path, 'a') as handle:
        for line in lines:
            handle.write(line + '\n')


def connect(db):
    conn = sqlite3.connect(f'file:{db}?mode=ro', uri=True)
    conn.row_factory = sqlite3.Row
    return conn


def max_event_id(conn):
    return conn.execute('select coalesce(max(id), 0) from client_events').fetchone()[0]


def game_label(conn, game_id):
    if not game_id:
        return 'the app shell'
    row = conn.execute('select slug, title from games where id = ?', (game_id,)).fetchone()
    return clean(row['slug'] or row['title'], 80) if row else clean(game_id, 80)


def release_for(conn, build_id):
    """The publish that shipped this build, if any: release version, tag, time, and the commit and repo to find its PR."""
    if not build_id:
        return None
    row = conn.execute(
        """select r.version, r.git_tag, r.published_at, b.git_sha, g.github_owner, g.github_repo
             from builds b join games g on g.id = b.game_id
             left join releases r on r.build_id = b.id
            where b.id = ? order by r.seq desc limit 1""",
        (build_id,),
    ).fetchone()
    return dict(row) if row else None


def pr_for(release, gh):
    if not release or not release.get('git_sha') or not release.get('github_owner') or not release.get('github_repo'):
        return None
    try:
        run = subprocess.run(
            [*gh, 'pr', 'list', '-R', f"{release['github_owner']}/{release['github_repo']}", '--state', 'merged', '--search', release['git_sha'],
             '--json', 'url', '--limit', '1'],
            capture_output=True, text=True, timeout=60,
        )
        found = json.loads(run.stdout or '[]') if run.returncode == 0 else []
    except (subprocess.TimeoutExpired, json.JSONDecodeError, OSError):
        return None
    return found[0]['url'] if found else None


def publish_note(release, pr):
    if not release or not release.get('version'):
        return 'unpublished build'
    note = f"release {clean(release['version'], 40)} ({clean(release['git_tag'], 80)}, {clean(release['published_at'], 30)})"
    return f'{note}, PR {pr}' if pr else note


def new_groups(conn, cursor, upto):
    return conn.execute(
        """select g.*, e.user_id, e.origin, e.app_version, e.device, e.detail_json, e.at
             from crash_groups g join client_events e on e.id = g.first_event_id
            where g.first_event_id > ? and g.first_event_id <= ? order by g.first_event_id""",
        (cursor, upto),
    ).fetchall()


def app_opens(conn, cursor, upto):
    return conn.execute(
        """select e.*, u.name from client_events e left join user u on u.id = e.user_id
            where e.kind = 'app_open' and e.id > ? and e.id <= ? order by e.id""",
        (cursor, upto),
    ).fetchall()


def recent_crash_groups(conn, now):
    since = (now - timedelta(days=1)).isoformat().replace('+00:00', 'Z')
    return conn.execute('select count(*) from crash_groups where last_seen_at >= ?', (since,)).fetchone()[0]


def issue_body(conn, group, detail, game, note):
    breadcrumbs = '\n'.join(clean(crumb, 120) for crumb in detail.get('breadcrumbs') or []) or 'none'
    origin = web_origin(group['origin'])
    path = f"{origin}/g/{clean(group['game_id'], 128)}" if group['game_id'] else origin
    return '\n'.join([
        f'A player hit a new crash in {game}. Filed by ogm-telemetry-listen from client telemetry (#1318).',
        '',
        f"- Kind: `{clean(group['crash'], 40)}` at step `{clean(detail.get('step') or 'unknown', 20)}`",
        f"- Game: `{clean(group['game_id'] or 'none', 128)}`, build `{clean(group['build_id'] or 'none', 128)}`",
        f'- Publish: {note}',
        f"- Device: {device_name(group['device'])}, app `{clean(group['app_version'], 64)}`, domain {origin}",
        f"- First seen: {clean(group['first_seen_at'], 30)}",
        f"- Signature: `{clean(group['signature'], 64)}`",
        '',
        'Message:',
        fenced(detail.get('message') or group['message'], 500),
        'Stack:',
        fenced(detail.get('stack') or 'none'),
        'Breadcrumbs (oldest first):',
        fenced(breadcrumbs, 2500),
        'User agent:',
        fenced(group['device'], 200),
        '',
        f'Repro hint: open {path} on the device above and play to the step above; the breadcrumbs are the path taken.',
        'Counts: `ogm-telemetry-listen stats`.',
    ])


def file_issue(gh, repo, title, body):
    run = subprocess.run(
        [*gh, 'issue', 'create', '-R', repo, '--title', title, '--body', body,
         *[part for label in ISSUE_LABELS for part in ('--label', label)]],
        capture_output=True, text=True, timeout=60,
    )
    if run.returncode != 0:
        raise RuntimeError(clean(run.stderr, 200))
    match = re.search(r'/issues/(\d+)', run.stdout)
    if not match:
        raise RuntimeError(f'no issue url in: {clean(run.stdout, 200)}')
    return int(match.group(1))


def comment_issue(gh, repo, number, body):
    run = subprocess.run([*gh, 'issue', 'comment', str(number), '-R', repo, '--body', body],
                         capture_output=True, text=True, timeout=60)
    if run.returncode != 0:
        raise RuntimeError(clean(run.stderr, 200))


def raise_issue(conn, gh, repo, state, key, now):
    """Open or comment on the issue for one crash group; True once it needs no more (filed, or deliberately skipped)."""
    game_id, build_id, signature = key
    if game_id and conn.execute('select 1 from games where id = ?', (game_id,)).fetchone() is None:
        print(f'ogm-telemetry-listen: no issue for {signature[:12]}: unknown game', file=sys.stderr)
        return True
    hour_ago = now.timestamp() - 3600
    state['writes'] = [at for at in state['writes'] if at > hour_ago]
    if len(state['writes']) >= GITHUB_WRITES_PER_HOUR:
        print(f'ogm-telemetry-listen: no issue for {signature[:12]}: {GITHUB_WRITES_PER_HOUR} GitHub writes this hour',
              file=sys.stderr)
        return True
    group = conn.execute(
        """select g.*, e.origin, e.app_version, e.device, e.detail_json
             from crash_groups g join client_events e on e.id = g.first_event_id
            where g.game_id = ? and g.build_id = ? and g.signature = ?""",
        key,
    ).fetchone()
    if group is None:
        return True
    detail = json.loads(group['detail_json'] or '{}')
    game = game_label(conn, game_id)
    release = release_for(conn, build_id)
    note = publish_note(release, pr_for(release, gh))
    known = state['issues'].get(signature)
    try:
        if known:
            comment_issue(gh, repo, known, f"Seen again in build `{clean(build_id or 'none', 128)}` ({note}), "
                                           f"{clean(group['first_seen_at'], 30)}, on {device_name(group['device'])}.")
        else:
            title = f"Crash: {clean(group['crash'], 40)} in {game}: {clean(group['message'], 70)}"
            state['issues'][signature] = file_issue(gh, repo, title, issue_body(conn, group, detail, game, note))
    except (RuntimeError, subprocess.TimeoutExpired, OSError) as error:
        print(f'ogm-telemetry-listen: issue for {signature[:12]} deferred: {error}', file=sys.stderr)
        return False
    state['writes'].append(now.timestamp())
    return True


def run_pass(conn, state, opts, now, save):
    """One pass. State is saved as soon as the lines are out and after each GitHub write, so a failure later in the pass
    neither repeats lines nor files an issue twice."""
    lines = []
    cursor = state['cursor']
    # Read the bound first: rows the API commits during the pass belong to the next one.
    upto = max_event_id(conn)
    for group in new_groups(conn, cursor, upto):
        detail = json.loads(group['detail_json'] or '{}')
        game = game_label(conn, group['game_id'])
        release = release_for(conn, group['build_id'])
        lines.append(
            f"- {stamp(now)} telemetry: crash {clean(group['crash'], 40)} in {game} build "
            f"{clean(group['build_id'] or 'none', 40)} ({publish_note(release, None)}) at "
            f"{clean(detail.get('step') or 'unknown step', 20)} on {device_name(group['device'])}: "
            f"{clean(group['message'], 160)} [sig {group['signature'][:12]}]"
        )
        state['pending'].append([group['game_id'], group['build_id'], group['signature']])
    opens = app_opens(conn, cursor, upto)
    if opens:
        crashes = recent_crash_groups(conn, now)
        for event in opens:
            # The post-deploy play check drives the real shell headless; its opens are not a person arriving.
            if 'Headless' in (event['device'] or ''):
                continue
            detail = json.loads(event['detail_json'] or '{}')
            lines.append(
                f"- {stamp(now)} telemetry: app {'resumed' if detail.get('resumed') else 'opened'} by "
                f"{clean(event['name'] or event['user_id'], 60)} on {device_name(event['device'])} at "
                f"{web_origin(event['origin'])} (app {clean(event['app_version'], 20)}); "
                f'crash groups seen in the last day: {crashes}'
            )
    state['cursor'] = max(cursor, upto)
    if not opts['issues']:
        state['pending'] = []
    append_attention(opts['attention'], lines)
    save()
    for line in lines:
        print(line, flush=True)
    for key in list(state['pending']):
        if raise_issue(conn, opts['gh'], opts['repo'], state, tuple(key), now):
            state['pending'].remove(key)
            save()


def listen(opts):
    state = load_state(opts['state'])
    if state is None:
        with connect(opts['db']) as conn:
            state = {'cursor': max_event_id(conn), 'issues': {}, 'pending': [], 'writes': []}
        save_state(opts['state'], state)
    while True:
        try:
            with connect(opts['db']) as conn:
                run_pass(conn, state, opts, datetime.now(timezone.utc), lambda: save_state(opts['state'], state))
        except sqlite3.Error as error:
            # The API creates the tables; until it has migrated, there is nothing to read.
            print(f'ogm-telemetry-listen: pass failed: {error}', file=sys.stderr, flush=True)
            if opts['once']:
                return 70
        if opts['once']:
            return 0
        time.sleep(opts['interval'])


def stats(db, days):
    since = (datetime.now(timezone.utc) - timedelta(days=days)).isoformat().replace('+00:00', 'Z')
    with connect(db) as conn:
        rows = conn.execute(
            """select coalesce(e.game_id, '') game, coalesce(e.build_id, '') build,
                      count(distinct case when e.kind in ('first_frame', 'crash') then e.session_id end) sessions,
                      sum(e.kind = 'first_frame') first_frames, sum(e.kind = 'in_world') in_world,
                      sum(e.kind = 'crash') crashes, count(distinct case when e.kind = 'crash' then e.session_id end)
                      crashed_sessions
                 from client_events e
                where e.received_at >= ? and e.game_id is not null
                group by 1, 2 order by crashes desc, sessions desc""",
            (since,),
        ).fetchall()
        opens = conn.execute("select count(*) from client_events where kind = 'app_open' and received_at >= ?",
                             (since,)).fetchone()[0]
        print(f'app opens in the last {days} days: {opens}')
        print('game\tbuild\tsessions\tcrashed\tcrashes\tfirst-frame\tin-world rate')
        for row in rows:
            rate = f"{row['in_world'] / row['sessions']:.0%}" if row['sessions'] else '-'
            print(f"{game_label(conn, row['game'])}\t{row['build'] or '-'}\t{row['sessions']}\t"
                  f"{row['crashed_sessions']}\t{row['crashes']}\t{row['first_frames']}\t{rate}")
    return 0


def main(argv):
    command = 'stats' if argv[:1] == ['stats'] else 'listen'
    argv = argv[1:] if command == 'stats' else argv
    flags = {'--once', '--no-issues'}
    present = {arg for arg in argv if arg in flags}
    argv = [arg for arg in argv if arg not in flags]
    args = dict(zip(argv[::2], argv[1::2]))
    allowed = {'--db', '--days'} if command == 'stats' else {'--db', '--state', '--attention', '--repo', '--interval'}
    if len(argv) % 2 or set(args) - allowed or (command == 'stats' and present):
        print(__doc__.split('\n\n')[2], file=sys.stderr)
        return 64
    env_dir = os.environ.get('OGM_ENV_DIR', os.path.expanduser('~/.config/ogm/env'))
    api = env_file(os.path.join(env_dir, 'api.env'))
    db = args.get('--db') or os.path.join(api.get('OGM_DATA_DIR', ''), 'ogm.sqlite3')
    if not os.path.exists(db):
        print('ogm-telemetry-listen: no database', file=sys.stderr)
        return 64
    if command == 'stats':
        return stats(db, int(args.get('--days', '7')))
    state_dir = os.environ.get('OGM_STATE_DIR', os.path.expanduser('~/.local/state/ogm'))
    return listen({
        'db': db,
        'state': args.get('--state') or os.path.join(state_dir, 'telemetry-listen.json'),
        'attention': args.get('--attention') or os.environ.get('HS_ATTENTION') or os.environ.get('OGM_QA_ATTENTION'),
        'repo': args.get('--repo') or os.environ.get('OGM_TELEMETRY_REPO') or DEFAULT_REPO,
        'interval': float(args.get('--interval', '15')),
        'once': '--once' in present,
        'issues': '--no-issues' not in present,
        'gh': (os.environ.get('OGM_GH') or 'gh').split(),
    })


if __name__ == '__main__':
    sys.exit(main(sys.argv[1:]))
