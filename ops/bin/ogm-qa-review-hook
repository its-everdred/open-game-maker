#!/usr/bin/env bash
# OGM QA review hook: after a web deploy, run the prod review E2E (`gm qa review-e2e`) when the deploy touched the
# review screens or the review API, and wake the Executor when it fails. The host's auto-update calls it right after a
# successful deploy with the commits it deployed from and to.
#
# usage: ogm-qa-review-hook <have> <want> [--repo <checkout>] [--attention <file>]
#
#   <have> <want>  the deployed range; only paths changed in it decide whether the E2E runs
#   --repo         the deployed checkout (default: this script's repository)
#   --attention    the file the Executor listens on; a failure appends one line to it (default: $OGM_QA_ATTENTION)
#
# Review paths: apps/web/src/**review** and services/api/src/{review-rounds,commands,previews,qa}/. Before the run it
# mints a fresh QA session (ops/bin/ogm-qa-session). Stills land in <repo>/assets-local/review/app/qa-e2e/<want>/ and
# the run's log in ~/.local/state/ogm/qa/review-e2e/<want>.log. Prints the E2E's last line, `exit=<n> qa-review-e2e`.
#
# exit 0 passed or nothing to check; 1 the E2E or the session failed; 64 bad usage.

set -uo pipefail

usage() {
  printf 'usage: ogm-qa-review-hook <have> <want> [--repo <checkout>] [--attention <file>]\n' >&2
  exit 64
}

repo=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../.." && pwd)
attention=${OGM_QA_ATTENTION:-}
range=()
while (($#)); do
  case $1 in
    --repo | --attention)
      [[ $# -ge 2 ]] || usage
      declare "${1#--}=$2"
      shift 2
      ;;
    -*) usage ;;
    *)
      range+=("$1")
      shift
      ;;
  esac
done
((${#range[@]} == 2)) || usage
have=${range[0]}
want=${range[1]}

changed=$(git -C "$repo" diff --name-only "$have" "$want" 2> /dev/null) || {
  printf 'ogm-qa-review-hook: cannot diff %s..%s in %s\n' "$have" "$want" "$repo" >&2
  exit 64
}
if ! grep -qE '^apps/web/src/.*[Rr]eview|^services/api/src/(review-rounds|commands|previews|qa)/' <<< "$changed"; then
  printf 'ogm-qa-review-hook: no review change in %s..%s\n' "$have" "$want"
  exit 0
fi

sha=$(git -C "$repo" rev-parse --short=12 "$want")
logs=${OGM_QA_ROOT:-$HOME/.local/state/ogm/qa}/review-e2e
mkdir -p "$logs"
log=$logs/$sha.log
gm=${OGM_QA_GM:-node $repo/packages/gm-cli/dist/index.js}
session=${OGM_QA_SESSION_CMD:-$repo/ops/bin/ogm-qa-session}

{
  $session && (cd "$repo" && $gm qa review-e2e --sha "$sha" --out "$repo/assets-local/review/app/qa-e2e/$sha")
} > "$log" 2>&1
rc=$?
if ((rc != 0)) && [[ -n $attention ]]; then
  printf '%s qa-review-e2e failed on %s (exit %s): %s\n' "$(date -u +%FT%TZ)" "$sha" "$rc" "$log" >> "$attention"
fi
grep -E '^exit=[0-9]+ qa-review-e2e$' "$log" | tail -n 1 || printf 'exit=%s qa-review-e2e\n' "$rc"
exit $((rc == 0 ? 0 : 1))
