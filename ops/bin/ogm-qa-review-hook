#!/usr/bin/env bash
# OGM QA review hook: after a deploy, run the prod review E2E (`gm qa review-e2e`) when the deploy touched the review
# screens or the review API, and the prod voice E2E (`gm qa voice-e2e`, #879) when it touched a voice path, and wake the
# Executor when a run fails. New Game runs for template, games API or commit-service changes and on the daily timer.
# Deploys that touch a player's boot path (the shell, the bridge, the SDK, the games host, publishing) also play every
# published game in the production shell (ops/bin/ogm-qa-game-play, #1272); a game publish plays that game.
# Every run also checks that paid APIs stay refused to games while the admin setting is off (ops/bin/ogm-qa-paid-apis).
# The host's auto-update calls it right after a successful deploy with the commits it
# deployed from and to.
#
# usage: ogm-qa-review-hook <have> <want> [--daily] [--repo <checkout>] [--attention <file>]
#        ogm-qa-review-hook --game-publish <slug> <build-id> [--api <url>] [--repo <checkout>] [--attention <file>]
#        ogm-qa-review-hook --publish-sweep [--repo <checkout>] [--attention <file>]
#
#   <have> <want>  the deployed range; only paths changed in it decide which E2E runs
#   --repo         the deployed checkout (default: this script's repository)
#   --daily        run the New Game smoke even when no relevant paths changed
#   --attention    the file the Executor listens on; a failure appends one line to it (default: $OGM_QA_ATTENTION)
#
# Review paths: apps/web/src/**review**, the deck's apps/web/src/features/{worker-builds,commands-inbox}/ and
# app/StudioMenu*, and services/api/src/{review-rounds,commands,previews,qa,worker-progress,blobs,blob-proxy}/. Voice
# paths: the list in ops/voice-paths, the same one CI's voice host job reads. Before the runs it mints a fresh QA session
# (ops/bin/ogm-qa-session). Stills land in <repo>/assets-local/review/app/{qa-e2e,voice-e2e}/<want>/ and each run's log
# in ~/.local/state/ogm/qa/{review-e2e,voice-e2e}/<want>.log. Prints each E2E's last line, `exit=<n> qa-review-e2e` and
# `exit=<n> qa-voice-e2e`.
#
# exit 0 passed or nothing to check; 1 an E2E or the session failed; 64 bad usage.

set -uo pipefail

usage() {
  printf 'usage: ogm-qa-review-hook <have> <want> [--daily] [--repo <checkout>] [--attention <file>]\n' >&2
  printf '       ogm-qa-review-hook --game-publish <slug> <build-id> [--api <url>] [--repo <checkout>] [--attention <file>]\n' >&2
  printf '       ogm-qa-review-hook --publish-sweep [--repo <checkout>] [--attention <file>]\n' >&2
  exit 64
}

repo=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../.." && pwd)
attention=${OGM_QA_ATTENTION:-}
daily=0
range=()
game_publish=()
publish_sweep=0
api_url=
attention_message=
worst=0
while (($#)); do
  case $1 in
    --daily) daily=1; shift ;;
    --game-publish)
      [[ $# -ge 3 ]] || usage
      game_publish=("$2" "$3")
      shift 3
      ;;
    --publish-sweep) publish_sweep=1; shift ;;
    --api)
      [[ $# -ge 2 ]] || usage
      api_url=$2
      shift 2
      ;;
    --attention-message)
      [[ $# -ge 2 ]] || usage
      attention_message=$2
      shift 2
      ;;
    --repo | --attention)
      [[ $# -ge 2 ]] || usage
      declare "${1#--}=$2"
      shift 2
      ;;
    -*) usage ;;
    *)
      range+=("$1")
      shift
      ;;
  esac
done
if ((${#game_publish[@]})); then
  ((${#game_publish[@]} == 2 && ${#range[@]} == 0 && daily == 0 && publish_sweep == 0)) || usage
  slug=${game_publish[0]}
  build_id=${game_publish[1]}
elif ((publish_sweep)); then
  ((${#range[@]} == 0 && daily == 0)) || usage
else
  ((${#range[@]} == 2)) || usage
  have=${range[0]}
  want=${range[1]}
fi

# The deploy caller supplies the Executor's attention file. Remember it for the
# timer, which runs outside that caller's environment.
qa_root=${OGM_QA_ROOT:-${HOME:-$repo}/.local/state/ogm/qa}
attention_config=$qa_root/attention-path
if [[ -n $attention ]]; then
  mkdir -p "$qa_root"
  config_tmp=$(mktemp "$qa_root/.attention-path.XXXXXX")
  printf '%s\n' "$attention" > "$config_tmp"
  mv -f -- "$config_tmp" "$attention_config"
elif [[ -f $attention_config ]]; then
  IFS= read -r attention < "$attention_config" || :
fi

if ((publish_sweep)); then
  gm=${OGM_QA_GM:-node $repo/packages/gm-cli/dist/index.js}
  log_dir=$qa_root/game-publish
  mkdir -p "$log_dir"
  log=$log_dir/reconcile.log
  : > "$log"
  (cd "$repo" && timeout --kill-after=30 "${OGM_QA_TIMEOUT_SEC:-3600}" $gm qa publish-review-check --all) > "$log" 2>&1
  rc=$?
  if ((rc != 0)); then
    worst=1
    [[ -n $attention ]] && printf '%s published prototype review reconciliation failed (exit %s): %s\n' "$(date -u +%FT%TZ)" "$rc" "$log" >> "$attention"
  fi
  tail -n 1 "$log" || true
  printf 'exit=%s qa-publish-review-sweep\n' "$rc"
  exit "$worst"
fi

if ((${#game_publish[@]})); then
  gm=${OGM_QA_GM:-node $repo/packages/gm-cli/dist/index.js}
  log_dir=$qa_root/game-publish
  mkdir -p "$log_dir"
  log=$log_dir/$build_id.log
  : > "$log"
  check=(qa publish-review-check "$slug" "$build_id")
  [[ -z $api_url ]] || check+=(--api "$api_url")
  (cd "$repo" && timeout --kill-after=30 "${OGM_QA_TIMEOUT_SEC:-3600}" $gm "${check[@]}") > "$log" 2>&1
  rc=$?
  if ((rc != 0)); then
    worst=1
    message=${attention_message:-prototype review missing for published game $slug build $build_id}
    [[ -n $attention ]] && printf '%s %s (exit %s): %s\n' "$(date -u +%FT%TZ)" "$message" "$rc" "$log" >> "$attention"
  elif [[ -n $attention_message ]]; then
    if [[ -n $attention ]]; then
      printf '%s %s\n' "$(date -u +%FT%TZ)" "$attention_message" >> "$attention"
    else
      printf 'attention: %s\n' "$attention_message" >&2
    fi
  fi
  tail -n 1 "$log" || true
  printf 'exit=%s qa-publish-review-check\n' "$rc"
  # Every published game must still serve its entry script (#1197: a build rewrite 404ed every game for a day).
  boot_log=$log_dir/$build_id.boot.log
  ${OGM_QA_GAME_BOOT:-$repo/ops/bin/ogm-qa-game-boot} > "$boot_log" 2>&1
  boot_rc=$?
  if ((boot_rc != 0)); then
    worst=1
    [[ -n $attention ]] && printf '%s qa-game-boot failed after publishing %s (exit %s): %s\n' "$(date -u +%FT%TZ)" "$slug" "$boot_rc" "$boot_log" >> "$attention"
  fi
  printf 'exit=%s qa-game-boot\n' "$boot_rc"
  # Serving files is not playing (#1272: three stacked causes kept every game on "Try again" for a day): play the
  # published game in the production shell to a first frame and one input. Its own lines carry the trace and stills.
  play_log=$log_dir/$build_id.play.log
  play=(${OGM_QA_GAME_PLAY:-$repo/ops/bin/ogm-qa-game-play} --game "$slug" --build "$build_id" --repo "$repo")
  [[ -z $attention ]] || play+=(--attention "$attention")
  "${play[@]}" > "$play_log" 2>&1
  play_rc=$?
  ((play_rc == 0)) || worst=1
  # Exit 1 is a game that failed and wrote its own line; anything else (bad usage, a crash) wrote none.
  if ((play_rc != 0 && play_rc != 1)) && [[ -n $attention ]]; then
    printf '%s qa-game-play failed after publishing %s (exit %s): %s\n' "$(date -u +%FT%TZ)" "$slug" "$play_rc" "$play_log" >> "$attention"
  fi
  printf 'exit=%s qa-game-play\n' "$play_rc"
  exit "$worst"
fi

changed=$(git -C "$repo" diff --name-only "$have" "$want" 2> /dev/null) || {
  printf 'ogm-qa-review-hook: cannot diff %s..%s in %s\n' "$have" "$want" "$repo" >&2
  exit 64
}
# The deck is more than the files named review: its swipe, Command cards and menu live beside them.
review='^apps/web/src/(.*[Rr]eview|features/(worker-builds|commands-inbox)/|app/StudioMenu)'
review+='|^services/api/src/(review-rounds|commands|previews|qa|worker-progress|blobs|blob-proxy)/'
runs=()
grep -qE "$review" <<< "$changed" && runs+=(review)
mapfile -t voice_paths < "$(dirname -- "${BASH_SOURCE[0]}")/../voice-paths"
git -C "$repo" diff --quiet "$have" "$want" -- "${voice_paths[@]}" 2> /dev/null || runs+=(voice)
new_game='^(templates/game-[^/]+/|packages/game-repo-template/|services/api/src/games/|services/commit/)'
if ((daily)) || grep -qE "$new_game" <<< "$changed"; then runs+=(new-game); fi
games_cache='^(services/games-host/|services/api/src/(games|builds)/|apps/web/src/routes/games/)'
grep -qE "$games_cache" <<< "$changed" && runs+=(games-cache game-boot)
# What a player's boot runs through: the shell, the bridge and its contract, the SDK, the games host, publishing.
game_play='^(apps/web/(src/(routes/game|features/(editor|room))/|index\.html|vite\.config|package\.json)'
game_play+='|packages/(contracts|host|iframe-bridge|sdk)/|services/games-host/|services/api/src/(games|builds)/)'
grep -qE "$game_play" <<< "$changed" && runs+=(game-play)
# Free and fast, and the gate can regress from any path: it runs on every deploy (#1221).
runs+=(paid-apis)

sha=$(git -C "$repo" rev-parse --short=12 "$want")
gm=${OGM_QA_GM:-node $repo/packages/gm-cli/dist/index.js}
session=${OGM_QA_SESSION_CMD:-$repo/ops/bin/ogm-qa-session}
# A hung browser or call must not hold the hook (and the next deploy's check) forever; a timeout counts as a failure.
limit=${OGM_QA_TIMEOUT_SEC:-3600}
worst=0
session_rc=
for kind in "${runs[@]}"; do
  name=qa-$kind-e2e
  [[ $kind == games-cache ]] && name=qa-games-cache
  [[ $kind == game-boot ]] && name=qa-game-boot
  [[ $kind == game-play ]] && name=qa-game-play
  [[ $kind == paid-apis ]] && name=qa-paid-apis
  stills=qa-e2e
  [[ $kind == voice ]] && stills=voice-e2e
  [[ $kind == new-game ]] && stills=new-game-e2e
  logs=$qa_root/$kind-e2e
  [[ $kind == games-cache ]] && logs=$qa_root/games-cache
  [[ $kind == game-boot ]] && logs=$qa_root/game-boot
  [[ $kind == game-play ]] && logs=$qa_root/game-play
  [[ $kind == paid-apis ]] && logs=$qa_root/paid-apis
  mkdir -p "$logs"
  log=$logs/$sha.log
  : > "$log"
  # One fresh session serves both runs; its output goes to the first run's log.
  if [[ -z $session_rc ]]; then
    timeout --kill-after=30 "$limit" $session >> "$log" 2>&1
    session_rc=$?
  fi
  rc=$session_rc
  if ((rc == 0)); then
    if [[ $kind == paid-apis ]]; then
      timeout --kill-after=30 "$limit" ${OGM_QA_PAID_APIS:-$repo/ops/bin/ogm-qa-paid-apis} >> "$log" 2>&1
    elif [[ $kind == game-play ]]; then
      play=(${OGM_QA_GAME_PLAY:-$repo/ops/bin/ogm-qa-game-play} --repo "$repo")
      [[ -z $attention ]] || play+=(--attention "$attention")
      timeout --kill-after=30 "$limit" "${play[@]}" >> "$log" 2>&1
    elif [[ $kind == game-boot ]]; then
      timeout --kill-after=30 "$limit" ${OGM_QA_GAME_BOOT:-$repo/ops/bin/ogm-qa-game-boot} >> "$log" 2>&1
    elif [[ $kind == games-cache ]]; then
      (cd "$repo" && timeout --kill-after=30 "$limit" $gm qa games-cache --game blobs --json) >> "$log" 2>&1
    else
      (cd "$repo" && timeout --kill-after=30 "$limit" $gm qa "$kind-e2e" --sha "$sha" --out "$repo/assets-local/review/app/$stills/$sha") >> "$log" 2>&1
    fi
    rc=$?
  fi
  if ((rc != 0)); then
    worst=1
    # A game that failed to play wrote its own line, with its trace and stills (exit 1); anything else did not.
    [[ -n $attention ]] && ! [[ $kind == game-play && $rc == 1 && $session_rc == 0 ]] && printf '%s %s failed on %s (exit %s): %s\n' "$(date -u +%FT%TZ)" "$name" "$sha" "$rc" "$log" >> "$attention"
  fi
  grep -E "^exit=[0-9]+ $name\$" "$log" | tail -n 1 || printf 'exit=%s %s\n' "$rc" "$name"
  # Without a session every run would fail the same way: wake the Executor once.
  ((session_rc == 0)) || break
done
exit "$worst"
