#!/usr/bin/env bash
# OGM operator publish: build one registered game at a git SHA and publish the build through the API's build
# publisher. A game registered against a repository whose own tickets are not Game Maker jobs never stages a build
# through its daemon's `before_remove` hook, so nothing uploads a build for it; this script is that upload.
#
# usage: ogm-publish <game-slug> [--sha <ref>] [--checkout <path>] [--api <url>] [--keep] [--json]
#
#   --sha       commit to build; a 40-character SHA or any ref git resolves (default: the checkout's origin/main)
#   --checkout  the repository checkout to build from (default: the daemon row's registered checkout)
#   --api       the API's loopback base URL (default: http://127.0.0.1:$OGM_API_PORT)
#   --keep      keep the scratch worktree and the archive for inspection
#   --json      print the API's answer as one JSON line
#
# exit 0 published; 2 the build or the upload failed; 64 bad usage; 65 no game, no checkout or no internal token.
# The internal token is read from ~/.config/ogm/env/api.env (or OGM_INTERNAL_TOKEN); nothing here prints it.

set -uo pipefail

# A fetch from an origin that wants credentials must fail instead of prompting on a host with no terminal.
export GIT_TERMINAL_PROMPT=0

usage() {
  printf 'usage: ogm-publish <game-slug> [--sha <ref>] [--checkout <path>] [--api <url>] [--keep] [--json]\n' >&2
  exit 64
}

slug=
sha=
checkout=
api=
keep=0
json=0
while (($#)); do
  case $1 in
    --sha)
      sha=${2:-}
      shift 2 || usage
      ;;
    --checkout)
      checkout=${2:-}
      shift 2 || usage
      ;;
    --api)
      api=${2:-}
      shift 2 || usage
      ;;
    --keep)
      keep=1
      shift
      ;;
    --json)
      json=1
      shift
      ;;
    -h | --help) usage ;;
    -*) usage ;;
    *)
      [[ -n $slug ]] && usage
      slug=$1
      shift
      ;;
  esac
done
[[ -n $slug ]] || usage

say() { ((json)) || printf '%s\n' "$*"; }
fail() {
  printf 'ogm-publish: %s\n' "$*" >&2
  exit "${2:-2}"
}

env_dir=${OGM_ENV_DIR:-$HOME/.config/ogm/env}

# Read one name out of a unit's env file without sourcing it: the files also hold secrets.
env_value() {
  grep -E "^$2=" "$env_dir/$1.env" 2> /dev/null | tail -n 1 | cut -d= -f2- | sed -e 's/^"//' -e 's/"$//' || true
}

token=${OGM_INTERNAL_TOKEN:-$(env_value api OGM_INTERNAL_TOKEN)}
port=${OGM_API_PORT:-$(env_value api OGM_API_PORT)}
assets_root=${OGM_ASSETS_ROOT:-$(env_value api OGM_ASSETS_ROOT)}
api=${api:-${OGM_API_URL:-http://127.0.0.1:${port:-0}}}
[[ -n $token ]] || fail "no internal token: set OGM_INTERNAL_TOKEN or put one in $env_dir/api.env" 65
[[ -n $port ]] || fail "no API port: set OGM_API_PORT or put one in $env_dir/api.env" 65

# The registered game's own facts: its folder in the instance repository and the checkout its daemon row names.
facts=$(curl -fsS --max-time 20 -H "x-ogm-internal: $token" "$api/internal/operator/games/$slug" 2> /dev/null) ||
  fail "the API did not answer for game \"$slug\" at $api" 65
read -r game_id repo_path daemon_checkout < <(printf '%s' "$facts" | node -e '
  let raw = "";
  process.stdin.on("data", (chunk) => (raw += chunk));
  process.stdin.on("end", () => {
    const game = JSON.parse(raw);
    process.stdout.write([game.game.id, game.game.repo.path ?? "", game.daemon?.checkoutPath ?? ""].join("\t") + "\n");
  });
')
[[ -n $game_id ]] || fail "the API's answer for \"$slug\" carried no game id" 65
[[ -n $repo_path ]] || fail "game \"$slug\" has no repository folder registered; register the game first" 65

checkout=${checkout:-$daemon_checkout}
[[ -n $checkout ]] || fail "no checkout: pass --checkout or register the game with a daemon checkout" 65
[[ -d $checkout ]] || fail "checkout not found: $checkout" 65
git -C "$checkout" rev-parse --git-dir > /dev/null 2>&1 || fail "not a git checkout: $checkout" 65

# Resolve the ref to a commit; a ref that only exists on the remote needs one fetch first.
ref=${sha:-origin/main}
commit=$(git -C "$checkout" rev-parse --verify --quiet "${ref}^{commit}" 2> /dev/null) || {
  git -C "$checkout" fetch --quiet origin > /dev/null 2>&1 || true
  commit=$(git -C "$checkout" rev-parse --verify --quiet "${ref}^{commit}" 2> /dev/null) || true
}
[[ $commit =~ ^[0-9a-f]{40}$ ]] || fail "cannot resolve \"$ref\" to a commit in $checkout" 65
say "building $repo_path at $commit"

work_root=${OGM_PUBLISH_WORK_ROOT:-$HOME/.local/state/ogm/publish}
mkdir -p "$work_root" || fail "cannot create $work_root" 65
# git refuses a worktree path that already exists, so the scratch directory names a child it creates itself.
scratch=$(mktemp -d "$work_root/$slug.XXXXXX") || fail "cannot create a work directory in $work_root" 65
work=$scratch/$slug
stage=
cleanup() {
  [[ -n $stage ]] && rm -rf -- "$stage"
  if ((keep)); then
    say "kept the worktree at $work" >&2
  else
    git -C "$checkout" worktree remove --force "$work" > /dev/null 2>&1 || true
    rm -rf -- "$scratch"
  fi
}
trap cleanup EXIT

git -C "$checkout" worktree add --quiet --detach "$work" "$commit" ||
  fail "cannot check $commit out of $checkout" 65
game_dir=$work/$repo_path
[[ -d $game_dir ]] || fail "$repo_path is not in $checkout at $commit" 65

# The game's own build script is its production build; a script that already names a base or a mode keeps it. The base
# stays relative because the games host serves every build under /g/<gameId>/<buildId>/.
build_script=$(cd "$game_dir" && node -p 'const p = require("./package.json"); (p.scripts && p.scripts.build) || ""')
[[ -n $build_script ]] || fail "$repo_path has no build script" 65
extra=()
[[ $build_script == *--base* ]] || extra+=(--base=./)
[[ $build_script == *--mode* ]] || extra+=(--mode=published)
say "build: pnpm run build -- ${extra[*]}"

export NODE_ENV=production
[[ -n $assets_root ]] && export OGM_ASSETS_ROOT=$assets_root
( cd "$work" && pnpm install --frozen-lockfile --prefer-offline > /dev/null ) ||
  fail "pnpm install failed in the worktree" 2
if ((${#extra[@]})); then
  ( cd "$game_dir" && pnpm run build -- "${extra[@]}" ) || fail "the game's build failed" 2
else
  ( cd "$game_dir" && pnpm run build ) || fail "the game's build failed" 2
fi

dist=$game_dir/dist
[[ -f $dist/index.html ]] || fail "the build wrote no dist/index.html" 2
for file in manifest.json design/design.json credits.json; do
  [[ -f $dist/$file ]] || fail "the build wrote no dist/$file" 2
done
grep -Fq '="/assets/' "$dist/index.html" && fail "dist/index.html loads assets from the origin root; set a relative base" 2

# The archive the daemon's hook uploads: dist/ contents plus the repository's manifest and base design.
stage=$(mktemp -d "$work_root/$slug-stage.XXXXXX") || fail "cannot create an archive directory" 2
cp -PR "$dist/." "$stage/" || fail "cannot copy dist/" 2
for file in manifest.json design/design.json achievements.json; do
  if [[ -f $game_dir/$file ]]; then
    mkdir -p "$stage/$(dirname "$file")" && cp "$game_dir/$file" "$stage/$file" || fail "cannot copy $file" 2
  fi
done
archive=$work_root/$slug-$commit.tgz
tar --format=ustar -czf "$archive" -C "$stage" . || fail "cannot archive the build" 2

body=$(mktemp "$work_root/answer.XXXXXX") || fail "cannot create a response file" 2
status=$(curl -sS --max-time 300 -o "$body" -w '%{http_code}' -X POST \
  -H "x-ogm-internal: $token" -H "x-gm-sha: $commit" -H 'content-type: application/gzip' \
  --data-binary @"$archive" "$api/internal/operator/games/$slug/builds" 2> /dev/null) || status=000
answer=$(cat "$body" 2> /dev/null || true)
rm -f -- "$body"
((keep)) || rm -f -- "$archive"

if ((json)); then
  printf '%s\n' "${answer:-{\"error\":{\"code\":\"no_answer\"}}}"
fi
case $status in
  201)
    ((json)) || printf 'published %s at %s\n' "$repo_path" "$commit"
    exit 0
    ;;
  422)
    ((json)) || printf 'not published (%s): %s\n' "$commit" "${answer:-no answer}" >&2
    exit 2
    ;;
  000)
    fail "no answer from $api" 2
    ;;
  *)
    fail "the API answered HTTP $status: ${answer:-no answer}" 2
    ;;
esac
