#!/usr/bin/env bash
# OGM operator publish: a thin wrapper for `gm publish`, which builds one registered game at its repository's remote
# main (or --sha) and publishes the build through the API's operator routes. Arguments pass through unchanged; see
# `gm help publish` and docs/ops/runbook.md. Needs a built gm CLI (pnpm --filter @ogm/gm-cli build).

set -uo pipefail

gm=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../.." && pwd)/packages/gm-cli/dist/index.js
[[ -f $gm ]] || {
  printf 'ogm-publish: %s is not built. Try: pnpm --filter @ogm/gm-cli build\n' "$gm" >&2
  exit 2
}
exec node "$gm" publish "$@"
