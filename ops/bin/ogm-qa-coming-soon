#!/usr/bin/env python3
"""Check that the QA account and unsigned requests cannot open a coming-soon game's build.

Usage: ogm-qa-coming-soon [--slug SLUG] [--db PATH] [--app ORIGIN] [--games ORIGIN]
Reads QA cookie and API defaults from OGM_ENV_DIR (default ~/.config/ogm/env); never prints the cookie.
"""
import argparse
import json
import os
import sqlite3
import sys
import urllib.error
import urllib.request
from urllib.parse import quote


def env_file(path):
    values = {}
    try:
        with open(path, encoding='utf-8') as handle:
            for line in handle:
                if '=' in line and not line.lstrip().startswith('#'):
                    key, value = line.split('=', 1)
                    values[key.strip()] = value.strip().strip('"')
    except FileNotFoundError:
        pass
    return values


def status(url, headers=None):
    request = urllib.request.Request(url, headers=headers or {})
    try:
        with urllib.request.urlopen(request, timeout=30) as response:
            return response.status
    except urllib.error.HTTPError as error:
        return error.code
    except (urllib.error.URLError, TimeoutError):
        return None


def card_visible(url, headers, game_id):
    try:
        request = urllib.request.Request(url, headers=headers)
        with urllib.request.urlopen(request, timeout=30) as response:
            if response.status != 200:
                return False
            body = json.load(response)
        return any(game.get('id') == game_id and game.get('canPlay') is False and
                   game.get('releaseState') == 'coming_soon' for game in body.get('games', []))
    except (urllib.error.URLError, TimeoutError, ValueError, AttributeError):
        return False


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--slug', default='dusk-helm')
    parser.add_argument('--db')
    parser.add_argument('--app')
    parser.add_argument('--games')
    args = parser.parse_args()
    env_dir = os.environ.get('OGM_ENV_DIR', os.path.expanduser('~/.config/ogm/env'))
    api = env_file(os.path.join(env_dir, 'api.env'))
    qa = env_file(os.path.join(env_dir, 'qa.env'))
    db = args.db or os.path.join(api.get('OGM_DATA_DIR', ''), 'ogm.sqlite3')
    app = (args.app or api.get('OGM_APP_ORIGIN', '')).rstrip('/')
    games = (args.games or api.get('OGM_GAMES_ORIGIN', '')).rstrip('/')
    name, cookie = qa.get('OGM_QA_SESSION_COOKIE_NAME'), qa.get('OGM_QA_SESSION_COOKIE')
    if not all((app, games, name, cookie)) or not os.path.isfile(db):
        print('qa-coming-soon: missing app, games, database, or QA session', file=sys.stderr)
        return 65
    with sqlite3.connect(f'file:{db}?mode=ro', uri=True) as conn:
        row = conn.execute("""select g.id, g.release_state, (select b.id from builds b where b.game_id = g.id
            and b.status = 'tested' order by b.created_at desc limit 1) from games g where g.slug = ?""", (args.slug,)).fetchone()
    if not row or row[1] != 'coming_soon' or not row[2]:
        print('qa-coming-soon: game missing, not coming soon, or no tested build', file=sys.stderr)
        return 1
    headers = {'Cookie': f'{name}={cookie}'}
    checks = {
        'QA card visible and restricted': card_visible(f'{app}/api/v1/games', headers, row[0]),
        'QA play link denied': status(f'{app}/api/v1/games/resolve/{quote(args.slug, safe="")}', headers) == 403,
        'QA edit denied': status(f'{app}/api/v1/games/{quote(row[0], safe="")}/branches/main/design', headers) == 403,
        'QA build list denied': status(f'{app}/api/v1/games/{quote(row[0], safe="")}/builds', headers) == 403,
        'unsigned build denied': status(f'{games}/g/{quote(row[0], safe="")}/{quote(row[2], safe="")}/') == 403,
    }
    for label, passed in checks.items():
        print(f'{label}: {"ok" if passed else "failed"}')
    return 0 if all(checks.values()) else 1


if __name__ == '__main__':
    sys.exit(main())
